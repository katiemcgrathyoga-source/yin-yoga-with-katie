# build output
dist/
# generated types
.astro/
# dependencies
node_modules/
# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# environment variables
.env
.env.production
.env*
!.env.example
# macOS / editor
.DS_Store
.vscode/
# reference material — kept locally, never built or deployed (large / copyrighted)
/docs/
# brand strategy / presentation decks — reference, not site source
/*.pdf

# analytics exports — local inputs to scripts/generate-video-skeletons.mjs.
# Contain subscriber counts & estimated revenue, so never committed. The
# generated src/content/videos/*.md are committed, so the site builds without these.
# NOTE: leading slash anchors this to the repo-root data/ ONLY — an unanchored
# `data/` would also swallow src/data/ (site config, programs, week themes)!
/data/

# raw brand/design source kept locally, not deployed. The site uses copies:
# logos in public/brand/, the self-hosted script font in public/fonts/. Noto
# Serif TC + Cabin load from Google Fonts (the full CJK .ttf files are ~76MB).
/*.ttf
/Yin Yoga with Katie Design System/

# misc
desktop.ini
*.zip

# design handoff packages + raw brand images — reference, not site source.
# `design_handoff_*` matches ANY handoff folder dropped at the repo root.
/design_handoff_*/
/brand images/
/blog blueprint.md
scripts/.cache-Cabin.ttf

# Local Netlify folder
.netlify

# raw + intermediate video. Class masters run to gigabytes and the review
# renders to hundreds of megabytes; both are local working files, never source.
/raw_videos/
/edit-review/
*.mp4
# rnnoise model for the audio-cleaning pass — a downloadable binary asset,
# not project source.
/sh.rnnn

# Delivery encodes headed for Bunny Stream — build output from the ProRes
# masters on D:, never source. Regenerate with scripts/prepare-bunny.sh.
/processed_videos/

# Generated pin previews — reproduce with scripts/preview-pins.mjs
design/pin-preview/
