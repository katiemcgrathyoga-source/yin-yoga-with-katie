# Copy to .env for local `netlify dev`, and set the same keys in the Netlify
# dashboard (Site settings → Environment variables) for deploys. .env is
# gitignored; this .env.example is the committed template.

# --- Bunny Stream: self-hosted paid video (The Runner's Reset, membership) ---
# Stream library numeric ID.  Bunny dashboard → Stream → your library → the ID.
BUNNY_STREAM_LIBRARY_ID=
# The library's "Token Authentication Key".  Stream library → API / Security.
# Secret — do NOT expose to the browser; only the Netlify function reads it.
BUNNY_STREAM_TOKEN_KEY=
# SPIKE SAFETY: comma-separated video GUIDs this endpoint is allowed to sign.
# Keeps the un-authed spike endpoint from minting tokens for real paid videos.
# Remove once the Supabase entitlement check replaces it (phase 1).
BUNNY_STREAM_ALLOW=
# Signed-URL lifetime in seconds (default 3600 = 1 hour).
BUNNY_STREAM_TTL=3600

# --- Supabase: accounts + entitlements (Phase 1) ---
# From Supabase → Project Settings → API. URL + anon key are PUBLIC by design
# (row-level security is what actually protects data), so they ship to the
# client. The PUBLIC_ prefix is required for Astro to expose them to the browser.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Product key a buyer must own to watch (matches the 'product' column).
RUNNER_PRODUCT=runner-reset
# Escape hatch: set to 1 in LOCAL dev to bypass the gate when Supabase isn't
# configured. Leave UNSET everywhere else — the gate fails CLOSED without it, so
# a deploy missing the Supabase env denies access rather than exposing content.
DEV_OPEN_ACCESS=
# Service-role key (SECRET, server-only) — the Stripe webhook uses it to WRITE
# entitlements, and checkout uses it to count buyers. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Polar: payments, Merchant of Record (Phase 2) ---
# Organization Access Token (SECRET) — Settings → API Keys, scope checkouts:write.
POLAR_ACCESS_TOKEN=
# Webhook signing secret (SECRET) — the "whsec_..." value shown when you create
# the webhook endpoint (Settings → Webhooks → Add endpoint → /api/polar-webhook).
POLAR_WEBHOOK_SECRET=
# Product UUIDs for the two price tiers of The Runner's Reset (Products → your
# product → copy its ID from the URL). Founding = $49, Standard = $67. If only
# one is set, checkout always uses that one price (no founding/standard split).
POLAR_PRODUCT_FOUNDING=
POLAR_PRODUCT_STANDARD=
# Founding window size — founding product applies until this many buyers.
FOUNDING_LIMIT=100

# --- MailerLite: buyer suppression ---
# API key (SECRET) — MailerLite → Integrations → API. Used only by the Polar
# webhook, to add buyers to the group below.
MAILERLITE_API_KEY=
# Group ID of the buyers group (e.g. "runner-reset-buyer"). Set this group as the
# EXIT CONDITION on the runner nurture automation, so someone who buys stops
# receiving the sell emails. Without it, a buyer keeps being pitched for a week.
# Find the ID in the URL when you open the group in MailerLite.
MAILERLITE_BUYER_GROUP_ID=
