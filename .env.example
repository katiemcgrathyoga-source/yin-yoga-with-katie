# Copy to .env for local `netlify dev`, and set the same keys in the Netlify
# dashboard (Site settings → Environment variables) for deploys. .env is
# gitignored; this .env.example is the committed template.

# --- Bunny Stream: self-hosted paid video (The Runner's Reset, membership) ---
# Stream library numeric ID.  Bunny dashboard → Stream → your library → the ID.
BUNNY_STREAM_LIBRARY_ID=
# The library's "Token Authentication Key".  Stream library → API / Security.
# Secret — do NOT expose to the browser; only the Netlify function reads it.
BUNNY_STREAM_TOKEN_KEY=
# SPIKE SAFETY: comma-separated video GUIDs this endpoint is allowed to sign.
# Keeps the un-authed spike endpoint from minting tokens for real paid videos.
# Remove once the Supabase entitlement check replaces it (phase 1).
BUNNY_STREAM_ALLOW=
# Signed-URL lifetime in seconds (default 3600 = 1 hour).
BUNNY_STREAM_TTL=3600
