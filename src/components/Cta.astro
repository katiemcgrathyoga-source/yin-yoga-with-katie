---
/**
 * The site-wide call to action — one low-friction ask, in Katie's voice.
 *
 * TWO offers, because one message across 380 pages can't fit them all. The
 * retreat is the default and suits nearly any visitor; a runner reading about
 * post-run stretches is better served by the Post-Run Reset, which is both
 * contextually matched AND the funnel with a product behind it. A runner offer
 * on a "Yin for Sleep" page would convert nobody, so pages opt IN by tag rather
 * than the site switching wholesale.
 *
 * They post to different MailerLite forms on purpose: each triggers its own
 * automation, so a runner must not be dropped into the retreat series.
 *
 * Captures email INLINE (no extra click) by posting to MailerLite in a hidden
 * iframe, then swapping in our own thank-you. Every signup carries `source`
 * (custom field `signup_source`) so we can see which pages convert.
 *
 * `?for=runners` overrides the page's choice at load time. The Strava short
 * links (/r/legs and friends, see netlify.toml) carry it, because everyone
 * arriving that way is a runner even when the routine itself isn't tagged as
 * one — and those signups belong in the Runners group, not the retreat series.
 * Its `signup_source` gets a `strava-` prefix so the funnel is measurable.
 */
import { OFFERS } from '../lib/offers';

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  /** Which lead magnet to ask for. Pages opt in to 'runners' by tag. */
  offer?: keyof typeof OFFERS;
  /** Where this signup came from, e.g. "pose", "journal", "video". */
  source?: string;
  /**
   * Slim variant for a SECOND ask partway down a long page. Drops the badge and
   * the body paragraph and sets the heading smaller, so the mid-page card reads
   * as an aside rather than competing with the full card at the end.
   *
   * Why a mid-page ask exists at all: measured on the live site, the only ask on
   * a pose page sat 88% down and on a blog post 89% — nine and twelve screens of
   * scrolling. Most readers of the pages Google sends the most traffic to were
   * never shown one.
   */
  compact?: boolean;
}
const { offer = 'retreat', source = 'site', compact = false } = Astro.props;
const o = OFFERS[offer];
const {
  eyebrow = o.eyebrow,
  heading = o.heading,
  body = o.body,
} = Astro.props;
const ML_ACTION = o.action;
// The compact card drops the body, but an offer can keep ONE line saying what it
// is (the runner class is a filmed video, not another timed routine like the
// page it sits on). Rendered empty-but-present so a Strava arrival's offer swap
// can fill it in.
const compactLine = (o as { compact?: string }).compact ?? '';

// Unique per render so several capture cards on one page never collide.
const uid = 'cta-' + Math.random().toString(36).slice(2, 9);
const frame = uid + '-frame';
---

<section class={`membership cta-block${compact ? ' cta-compact' : ''}`} data-cta data-offer={offer} data-source={source}>
  <p class="eyebrow" data-cta-eyebrow>{eyebrow}</p>
  <h2 data-cta-heading>{heading}</h2>
  {!compact && <p class="cta-members" data-cta-badge>{o.badge}</p>}
  {!compact && <p data-cta-body>{body}</p>}
  {compact && <p class="cta-compact-line" data-cta-compact hidden={!compactLine}>{compactLine}</p>}

  <form
    class="rt-form cta-form"
    action={ML_ACTION}
    method="post"
    target={frame}
    data-cta-form
    aria-label={o.aria}
  >
    <label class="sr-only" for={uid + '-name'}>First name</label>
    <input
      id={uid + '-name'}
      type="text"
      name="fields[name]"
      placeholder="First name"
      autocomplete="given-name"
      required
      aria-required="true"
    />
    <label class="sr-only" for={uid + '-email'}>Email address</label>
    <input
      id={uid + '-email'}
      type="email"
      name="fields[email]"
      placeholder="you@email.com"
      autocomplete="email"
      required
      aria-required="true"
    />
    <input type="hidden" name="fields[signup_source]" value={source} />
    <input type="hidden" name="ml-submit" value="1" />
    <input type="hidden" name="anticsrf" value="true" />
    <button type="submit" class="btn-cta">{o.button}</button>
  </form>

  <p class="cta-fine" data-cta-fine>No spam, ever. Unsubscribe any time. I'll only send Yin.</p>
  <p class="cta-done" hidden role="status" data-cta-done>
    {o.done}
  </p>

  <iframe name={frame} class="lm-frame" title="Sign-up" tabindex="-1" aria-hidden="true"></iframe>
</section>

<script>
  import { OFFERS } from '../lib/offers';

  // A visitor from Strava is a runner, whatever the page is about, so the
  // retreat card becomes the Post-Run Reset — different copy AND a different
  // MailerLite form, so they land in the Runners group and its automation.
  // Build-time rendering can't know this: the pages are static and the signal
  // is in the URL. Without JS the retreat offer stands, which is still a
  // working signup rather than a broken one.
  if (new URLSearchParams(location.search).get('for') === 'runners') {
    const o = OFFERS.runners;
    // Tag EVERY card on the page, so a Strava arrival is countable even on a
    // routine already offering the runner class — otherwise the funnel's best
    // days would be invisible in the signup_source report.
    document.querySelectorAll('[data-cta]').forEach((card) => {
      const src = card.querySelector('input[name="fields[signup_source]"]') as HTMLInputElement | null;
      if (src && !src.value.startsWith('strava-')) src.value = `strava-${src.value}`;
    });
    document.querySelectorAll('[data-cta][data-offer="retreat"]').forEach((card) => {
      const set = (sel: string, text: string) => {
        const el = card.querySelector(sel);
        if (el) el.textContent = text;
      };
      set('[data-cta-eyebrow]', o.eyebrow);
      set('[data-cta-heading]', o.heading);
      set('[data-cta-badge]', o.badge);
      set('[data-cta-body]', o.body);
      const line = card.querySelector('[data-cta-compact]') as HTMLElement | null;
      if (line) { line.textContent = o.compact ?? ''; line.hidden = !o.compact; }
      set('[data-cta-done]', o.done);
      set('.btn-cta', o.button);
      const form = card.querySelector('[data-cta-form]') as HTMLFormElement | null;
      if (form) {
        form.action = o.action;
        form.setAttribute('aria-label', o.aria);
      }
      card.setAttribute('data-offer', 'runners');
    });
  }

  // Wire every inline capture card on the page. The POST lands in the card's
  // hidden iframe; we swap the form out for our own thank-you.
  document.querySelectorAll('[data-cta]').forEach((card) => {
    const form = card.querySelector('[data-cta-form]') as HTMLFormElement | null;
    const done = card.querySelector('[data-cta-done]') as HTMLElement | null;
    const fine = card.querySelector('[data-cta-fine]') as HTMLElement | null;
    form?.addEventListener('submit', () => {
      window.setTimeout(() => {
        form.hidden = true;
        if (fine) fine.hidden = true;
        if (done) done.hidden = false;
      }, 400);
    });
  });
</script>
