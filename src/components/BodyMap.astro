---
/**
 * "Where it works" — front and back figures with the muscles this session
 * works picked out in rose quartz, the rest left plain grey.
 *
 * Two views on one image, because most of what running tightens is posterior
 * (glutes, hamstrings, calves, lumbar) and the rest is anterior (hip flexors,
 * quads). A single front-facing figure can't honestly show a hamstring.
 *
 * Every muscle group is always drawn — so you can see the chain running loads —
 * and the ones this session works are the ones that lift. That's the difference
 * between a diagram and a highlighted band.
 *
 * The artwork is the same figure as the Strava muscle-map cards, so the course
 * and the public routine pages show one body. Each region is a clean render
 * edited with scripts/strava-map-edit.mjs (see STRAVA-SETUP.md, "Editing a
 * muscle map"); masters in design/bodymap-regions/, web copies in
 * public/bodymap/regions/. Only the muscles the session's poses actually work
 * are lit — a calf that nothing in the sequence touches stays grey.
 */
interface Props {
  region: 'hips' | 'hamstrings' | 'quads' | 'calves' | 'back' | 'full';
}
const { region } = Astro.props;

/** How to say what each session area works. */
const LABELS: Record<Props['region'], string> = {
  hips: 'the hip flexors, outer hip, glutes and lower back',
  quads: 'the quads, hip flexors, outer hip and side body',
  hamstrings: 'the hamstrings, glutes and lower back',
  calves: 'the calves, shins, feet, hamstrings and quads',
  back: 'the lower back, spine and side body',
  full: 'the whole lower body and lower back',
};

const label = LABELS[region];
---

<figure class="bmap">
  {/* One role="img": the two figures are a single diagram, and the figcaption
      below already states the message in text. */}
  <div class="bmap-plate" role="img" aria-label={`Diagram: this practice works ${label}`}>
    <img src={`/bodymap/regions/${region}.webp`} width="880" height="880" loading="lazy" decoding="async" alt="" />
    <span class="bmap-view-cap"><span>Front</span><span>Back</span></span>
  </div>

  <figcaption class="bmap-cap"><b>Where it works:</b> {label}.</figcaption>
</figure>

<style>
  .bmap { margin: 0; text-align: center; }

  /* The plate is always cream, in both themes — it's a mounted illustration, not
     a themed surface. The image carries the same cream, so there's no seam. */
  .bmap-plate {
    max-width: 300px;
    margin: 0 auto;
    padding: 6px 6px 8px;
    background: #F9F3E5;
    border: 1px solid rgba(72, 84, 76, 0.16);
    border-radius: 12px;
  }

  .bmap-plate img { display: block; width: 100%; height: auto; }

  /* Fixed color, not a theme variable: this text sits on the cream plate in
     dark mode too, where --ink-soft would be a pale gray and vanish. */
  .bmap-view-cap {
    display: flex;
    justify-content: space-around;
    margin-top: 2px;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #48544C;
  }

  .bmap-cap {
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 10px;
    line-height: 1.5;
  }
  .bmap-cap b { color: var(--ink); }
</style>
