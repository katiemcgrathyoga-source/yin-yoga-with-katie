---
import '../styles/global.css';
import { SITE } from '../data/site';

/**
 * The site-wide document shell. Owns the <head>: fonts, SEO title/description,
 * Open Graph + Twitter tags, canonical URL, and an optional JSON-LD block.
 * Every page renders inside this so SEO is consistent and defined in one place.
 */
interface Props {
  title: string;
  description: string;
  /** Open Graph overrides; fall back to title/description when omitted. */
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  /** Absolute or root-relative image URL for OG/Twitter cards. */
  image?: string;
  /** A pre-serialised JSON-LD object rendered as <script type="application/ld+json">. */
  jsonLd?: unknown;
  /** When true, emit <meta name="robots" content="noindex"> (thin/skeleton pages). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  image,
  jsonLd,
  noindex = false,
} = Astro.props;

// Canonical + absolute OG image, resolved against `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Sitewide entity graph — Organization + Person, present on every page (not just
// ones that pass their own jsonLd). This is what lets an AI answer engine or a
// Knowledge Panel resolve "who is this" and "who teaches this" even from a page
// with no other structured data (home, about). Merged with any page-level jsonLd
// below, rather than each page having to remember to add it.
const siteSocials = Object.values(SITE.socials).filter(Boolean);
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Yin Yoga with Katie',
  url: new URL('/', Astro.site).href,
  logo: new URL('/brand/submark-deep-sage.png', Astro.site).href,
  sameAs: siteSocials,
};
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Katie McGrath',
  jobTitle: 'Yin Yoga & Yoga Nidra Teacher',
  description: 'Yin Yoga & Yoga Nidra teacher based in Taipei, teaching since 2018.',
  url: new URL('/about', Astro.site).href,
  worksFor: { '@type': 'Organization', name: 'Yin Yoga with Katie' },
  sameAs: siteSocials,
};
const allJsonLd = [orgLd, personLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];

// Simple top nav, shared across every page. `aria-current` marks the section
// the current path falls under so the active link is highlighted.
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Start here', match: (p: string) => p === '/' },
  // The library has its own page now (it used to be the homepage), so it earns a
  // nav slot — and every page on the site links to the hub as a result.
  { href: '/videos', label: 'Classes', match: (p: string) => p.startsWith('/videos') },
  { href: '/poses', label: 'Poses', match: (p: string) => p.startsWith('/poses') },
  { href: '/routines', label: 'Routines', match: (p: string) => p.startsWith('/routines') },
  { href: '/blog', label: 'Journal', match: (p: string) => p.startsWith('/blog') },
  { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/brand/submark-deep-sage.png" />
    <link rel="alternate" type="application/rss+xml" title="Yin Yoga with Katie — Journal" href="/rss.xml" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#48544C" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Yin Yoga" />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@200..900&family=Cabin:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(allJsonLd)}
    />
  </head>
  <body>
    <script is:inline>
      (function () {
        try {
          var q = new URLSearchParams(location.search).get('theme');
          var t = (q === 'dark' || q === 'light') ? q : localStorage.getItem('theme');
          // Default to light everywhere; dark only when the visitor explicitly chooses it.
          if (t !== 'dark' && t !== 'light') t = 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <header class="topbar">
      <div class="bar">
        <a class="brand" href="/" aria-label="Yin Yoga with Katie — home">
          <img src="/brand/wordmark-deep-sage.png" alt="Yin Yoga with Katie" class="brand-logo brand-logo-light" width="176" height="30" />
          <img src="/brand/wordmark-soft-oat.png" alt="" class="brand-logo brand-logo-dark" width="176" height="30" aria-hidden="true" />
        </a>
        <div class="bar-end">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light / dark mode" title="Light / dark">
            <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 7 7 0 1 0 20 14.5z"/></svg>
            <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
          </button>
          <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
            <span class="nav-toggle-bars" aria-hidden="true"></span>
          </button>
          <nav class="nav" id="primary-nav" aria-label="Primary">
            {
              nav.map((item) => (
                <a href={item.href} class:list={[{ 'nav-cta': item.href === '/' }]} aria-current={item.match(path) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>
    <script>
      const t = document.getElementById('nav-toggle');
      const n = document.getElementById('primary-nav');
      if (t && n) {
        const close = () => { n.classList.remove('open'); t.setAttribute('aria-expanded', 'false'); };
        t.addEventListener('click', () => {
          const open = n.classList.toggle('open');
          t.setAttribute('aria-expanded', String(open));
        });
        n.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      }
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
    <slot />
    <div id="ios-install-banner" class="ios-install-banner is-hidden" role="note">
      <p>Add this to your Home Screen: tap <strong>Share</strong>, then <strong>Add to Home Screen</strong>.</p>
      <button type="button" id="ios-install-dismiss" aria-label="Dismiss">✕</button>
    </div>
    <footer class="site-footer">
      <img src="/brand/submark-deep-sage.png" alt="Yin Yoga with Katie" class="site-footer-logo site-footer-logo-light" width="125" height="104" loading="lazy" />
      <img src="/brand/submark-soft-oat.png" alt="" class="site-footer-logo site-footer-logo-dark" width="125" height="104" loading="lazy" aria-hidden="true" />
      <p class="site-footer-tag">a calmer, more flexible you — one long, slow practice at a time</p>
      <nav class="site-footer-nav" aria-label="Footer">
        <a href="/">Start here</a>
        <a href="/videos">Classes</a>
        <a href="/poses">Poses</a>
        <a href="/routines">Routines</a>
        <a href="/blog">Journal</a>
        <a href="/about">About</a>
        <a href="/free-class">Free class</a>
        {/* The only signposted route back for someone who has bought something.
            Static rather than a signed-in-only header link, because that would
            mean shipping an auth check to ~700 prerendered pages to serve the
            handful of people who need it. */}
        <a href="/account">Account</a>
        <button type="button" id="install-app-btn" class="footer-install is-hidden">Install app</button>
      </nav>
      <nav class="site-footer-social" aria-label="Katie on social media">
        {SITE.socials.substack && (
          <a href={SITE.socials.substack} target="_blank" rel="noopener" aria-label="Read Katie on Substack" title="Substack">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
          </a>
        )}
        {SITE.socials.instagram && (
          <a href={SITE.socials.instagram} target="_blank" rel="noopener" aria-label="Katie on Instagram" title="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.4"/><circle cx="12" cy="12" r="4.4"/><circle cx="17.6" cy="6.4" r="1.15" fill="currentColor" stroke="none"/></svg>
          </a>
        )}
        {SITE.socials.tiktok && (
          <a href={SITE.socials.tiktok} target="_blank" rel="noopener" aria-label="Katie on TikTok" title="TikTok">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.2v12.9a2.6 2.6 0 1 1-2.6-2.6c.27 0 .53.04.78.12v-3.3a5.9 5.9 0 0 0-.78-.05 5.9 5.9 0 1 0 5.9 5.9V9.4a7.5 7.5 0 0 0 4.36 1.4V7.6a4.28 4.28 0 0 1-3.4-1.78z"/></svg>
          </a>
        )}
        {SITE.socials.pinterest && (
          <a href={SITE.socials.pinterest} target="_blank" rel="noopener" aria-label="Katie on Pinterest" title="Pinterest">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.64 7.86 6.36 9.32-.09-.79-.17-2 .03-2.87.18-.76 1.18-4.82 1.18-4.82s-.3-.6-.3-1.5c0-1.4.82-2.45 1.83-2.45.86 0 1.28.65 1.28 1.42 0 .87-.55 2.17-.84 3.37-.24 1.01.5 1.83 1.5 1.83 1.8 0 3.18-1.9 3.18-4.64 0-2.42-1.74-4.12-4.23-4.12-2.88 0-4.57 2.16-4.57 4.4 0 .87.33 1.8.75 2.31.08.1.1.19.07.3l-.28 1.15c-.04.18-.15.22-.34.13-1.26-.59-2.05-2.42-2.05-3.9 0-3.18 2.31-6.1 6.66-6.1 3.5 0 6.22 2.49 6.22 5.82 0 3.47-2.19 6.27-5.23 6.27-1.02 0-1.98-.53-2.31-1.16l-.63 2.4c-.23.88-.85 1.98-1.26 2.65.95.29 1.95.45 3 .45 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
          </a>
        )}
        {SITE.socials.youtube && (
          <a href={SITE.socials.youtube} target="_blank" rel="noopener" aria-label="Katie on YouTube" title="YouTube">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.11-2.12C19.5 3.56 12 3.56 12 3.56s-7.5 0-9.39.52A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.11 2.12c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 0 0 2.11-2.12A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8zM9.6 15.57V8.43L15.8 12l-6.2 3.57z"/></svg>
          </a>
        )}
      </nav>
      {
        SITE.coffeeUrl && (
          <a class="footer-coffee" href={SITE.coffeeUrl} target="_blank" rel="noopener">
            ☕ Buy me a coffee
          </a>
        )
      }
      <p class="site-footer-copy">© Yin Yoga with Katie</p>
    </footer>
    <script>
      // Android/Chrome: capture the native install prompt so the footer button can
      // trigger it on demand (it's suppressed by default once a handler exists).
      let deferredPrompt: any = null;
      const installBtn = document.getElementById('install-app-btn');

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        installBtn?.classList.remove('is-hidden');
      });

      installBtn?.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        installBtn.classList.add('is-hidden');
      });

      window.addEventListener('appinstalled', () => {
        installBtn?.classList.add('is-hidden');
      });

      // iOS Safari has no beforeinstallprompt — show a small dismissible banner
      // nudging Share → Add to Home Screen, once, when not already installed
      // (standalone) and not previously dismissed.
      const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) && !(window as any).MSStream;
      const isStandalone =
        window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
      const dismissed = (() => {
        try {
          return localStorage.getItem('ios-install-dismissed') === '1';
        } catch (e) {
          return false;
        }
      })();

      if (isIOS && !isStandalone && !dismissed) {
        const banner = document.getElementById('ios-install-banner');
        banner?.classList.remove('is-hidden');
        document.getElementById('ios-install-dismiss')?.addEventListener('click', () => {
          banner?.classList.add('is-hidden');
          try {
            localStorage.setItem('ios-install-dismissed', '1');
          } catch (e) {}
        });
      }
    </script>
  </body>
</html>
