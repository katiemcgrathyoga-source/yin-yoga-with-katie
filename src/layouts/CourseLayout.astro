---
import '../styles/global.css';
import { SITE } from '../data/site';

/**
 * The shell for The Runner's Reset. Same document head, fonts and design tokens
 * as BaseLayout — but its own top bar, its own nav, and a deliberately quiet
 * footer, so the course reads as a place you practise rather than another page
 * of the public site.
 *
 * The visual treatment is controlled by `SITE.courseChrome` ('focused' |
 * 'familiar') — see src/data/site.ts. It lands here as `data-chrome` on the
 * shell, and every rule below is written against both values, so switching is
 * genuinely one line with nothing left stranded.
 */
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Shown small above the page title in the bar, e.g. "Post-Run Reset". */
  section?: string;
}

const { title, description, noindex = false, section } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const chrome = SITE.courseChrome;

const path = Astro.url.pathname;
const nav = [
  { href: '/sessions', label: 'Sessions', match: (p: string) => p.startsWith('/sessions') },
  { href: '/routines', label: 'Routines', match: (p: string) => p.startsWith('/routines') },
  { href: '/poses', label: 'Poses', match: (p: string) => p.startsWith('/poses') },
  { href: '/account', label: 'Account', match: (p: string) => p.startsWith('/account') },
];
---

<!doctype html>
<html lang="en" data-chrome={chrome}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#363F39" />
  </head>
  <body class="course">
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem('theme');
          if (t) document.documentElement.dataset.theme = t;
          else if (matchMedia('(prefers-color-scheme: dark)').matches)
            document.documentElement.dataset.theme = 'dark';
        } catch (e) {}
      })();
    </script>

    <header class="cbar">
      <div class="cbar-in">
        <a class="cbar-brand" href="/sessions">
          <span class="cbar-mark" aria-hidden="true">RR</span>
          <span class="cbar-name">The Runner's Reset</span>
        </a>

        <button class="ctheme" id="ctheme-toggle" type="button" aria-label="Toggle light / dark mode" title="Light / dark">
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 7 7 0 1 0 20 14.5z"/></svg>
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
        </button>

        <button class="cnav-toggle" id="cnav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="course-nav">
          <span class="cnav-bars" aria-hidden="true"></span>
        </button>

        <nav class="cnav" id="course-nav" aria-label="Course">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
      {section && <p class="cbar-section">{section}</p>}
    </header>

    <script>
      const t = document.getElementById('cnav-toggle');
      const n = document.getElementById('course-nav');
      if (t && n) {
        const close = () => { n.classList.remove('open'); t.setAttribute('aria-expanded', 'false'); };
        t.addEventListener('click', () => {
          const open = n.classList.toggle('open');
          t.setAttribute('aria-expanded', String(open));
        });
        n.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
      }
      document.getElementById('ctheme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="cfoot">
      <p class="cfoot-line">The Runner's Reset — yours for good.</p>
      <p class="cfoot-back"><a href="/">← Back to Yin Yoga with Katie</a></p>
    </footer>
  </body>
</html>

<style is:global>
  /* ── Course chrome ─────────────────────────────────────────────────────
     Two treatments, switched by SITE.courseChrome. 'focused' paints the bar
     and footer in deep sage regardless of light/dark, so the course keeps one
     steady identity; 'familiar' just uses the page surface like the rest of
     the site. */

  /* Sticky footer: course pages vary a lot in length (a gate card is very short),
     and the footer band floating mid-page looks broken. */
  body.course {
    background: var(--paper);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  body.course > main { flex: 1 0 auto; }
  body.course > .cfoot { flex-shrink: 0; }

  .ctheme {
    display: grid; place-items: center;
    width: 36px; height: 36px; margin-right: 4px;
    border-radius: 9px; cursor: pointer;
    background: transparent; border: 1px solid var(--line); color: var(--ink-soft);
  }
  .ctheme:hover { color: var(--ink); }
  .ctheme svg { width: 17px; height: 17px; }
  .ctheme .ico-sun { display: none; }
  [data-theme='dark'] .ctheme .ico-sun { display: block; }
  [data-theme='dark'] .ctheme .ico-moon { display: none; }

  .cbar { border-bottom: 1px solid var(--line); }
  .cbar-in {
    max-width: 1040px; margin: 0 auto; padding: 14px 22px;
    display: flex; align-items: center; gap: 18px;
  }
  .cbar-brand {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none; margin-right: auto;
  }
  .cbar-mark {
    display: grid; place-items: center;
    width: 30px; height: 30px; border-radius: 8px;
    font-family: var(--display); font-size: 13px; letter-spacing: .04em;
    background: var(--gold-solid); color: var(--paper);
  }
  .cbar-name {
    font-family: var(--display); font-size: 17px; letter-spacing: .01em;
    color: var(--ink);
  }
  .cbar-section {
    max-width: 1040px; margin: 0 auto; padding: 0 22px 12px;
    font-size: 13px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-soft);
  }

  .cnav { display: flex; gap: 22px; }
  .cnav a {
    font-size: 15px; text-decoration: none; color: var(--ink-soft);
    padding: 4px 0; border-bottom: 2px solid transparent;
  }
  .cnav a:hover { color: var(--ink); }
  .cnav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--gold-solid); }

  .cnav-toggle {
    display: none; width: 40px; height: 36px; border-radius: 9px;
    background: transparent; border: 1px solid var(--line); cursor: pointer;
  }
  .cnav-bars, .cnav-bars::before, .cnav-bars::after {
    display: block; width: 17px; height: 1.5px; background: var(--ink);
    margin: 0 auto; position: relative;
  }
  .cnav-bars::before, .cnav-bars::after { content: ''; position: absolute; left: 0; }
  .cnav-bars::before { top: -5px; }
  .cnav-bars::after { top: 5px; }

  .cfoot {
    margin-top: 64px; padding: 30px 22px 40px;
    border-top: 1px solid var(--line); text-align: center;
  }
  .cfoot-line { font-family: var(--display); font-size: 16px; color: var(--ink-soft); margin: 0 0 6px; }
  .cfoot-back { margin: 0; font-size: 14px; }
  .cfoot-back a { color: var(--ink-soft); }

  /* ── 'focused' — the course gets its own steady surface ─────────────── */
  [data-chrome='focused'] .cbar {
    background: var(--sage-deep);
    border-bottom-color: rgba(255, 255, 255, .08);
  }
  [data-chrome='focused'] .cbar-name { color: #f2ece2; }
  [data-chrome='focused'] .cbar-section { color: rgba(242, 236, 226, .62); }
  [data-chrome='focused'] .cbar-mark { background: var(--quartz); color: #363F39; }
  [data-chrome='focused'] .cnav a { color: rgba(242, 236, 226, .68); }
  [data-chrome='focused'] .cnav a:hover { color: #f2ece2; }
  [data-chrome='focused'] .cnav a[aria-current='page'] {
    color: #f2ece2; border-bottom-color: var(--quartz);
  }
  [data-chrome='focused'] .ctheme {
    border-color: rgba(255, 255, 255, .22); color: rgba(242, 236, 226, .7);
  }
  [data-chrome='focused'] .ctheme:hover { color: #f2ece2; }
  [data-chrome='focused'] .cnav-toggle { border-color: rgba(255, 255, 255, .22); }
  [data-chrome='focused'] .cnav-bars,
  [data-chrome='focused'] .cnav-bars::before,
  [data-chrome='focused'] .cnav-bars::after { background: #f2ece2; }
  [data-chrome='focused'] .cfoot {
    background: var(--sage-deep); border-top: none; margin-top: 72px;
  }
  [data-chrome='focused'] .cfoot-line { color: rgba(242, 236, 226, .78); }
  [data-chrome='focused'] .cfoot-back a { color: rgba(242, 236, 226, .6); }

  @media (max-width: 760px) {
    .cnav-toggle { display: block; }
    .cnav {
      display: none; position: absolute; right: 22px; top: 58px; z-index: 40;
      flex-direction: column; gap: 2px; padding: 10px 6px;
      background: var(--paper-2); border: 1px solid var(--line);
      border-radius: 12px; min-width: 172px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, .14);
    }
    .cnav.open { display: flex; }
    .cnav a { padding: 9px 14px; border-bottom: none; }
    .cnav a[aria-current='page'] { border-bottom: none; color: var(--gold-solid); }
    .cbar-in { position: relative; }
    [data-chrome='focused'] .cnav a { color: var(--ink-soft); }
    [data-chrome='focused'] .cnav a:hover { color: var(--ink); }
    [data-chrome='focused'] .cnav a[aria-current='page'] { color: var(--gold-solid); }
    .cbar-name { font-size: 15px; }
  }
</style>
