---
export const prerender = false; // SSR: gate member content server-side, never send it to non-buyers

import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import RoutinePlayer from '../../components/RoutinePlayer.astro';
import BodyMap from '../../components/BodyMap.astro';
import { checkAccess } from '../../lib/access';
import { signBunnyEmbed } from '../../lib/bunny';

/**
 * One reusable template for every course session. Rendered on demand so the
 * paywall is REAL: for 'members' sessions we check the visitor's entitlement
 * server-side (from the sb-token cookie) and only emit the video, timer, cues,
 * "why" and body map when they own it. Non-buyers receive just the gate — the
 * course material is never in the HTML they get. The video is additionally
 * signed server-side (short-lived Bunny URL). Free/preview classes use YouTube.
 */
const { slug } = Astro.params;
const sessions = await getCollection('sessions');
const session = sessions.find((s) => s.data.slug === slug);
if (!session) return new Response('Not found', { status: 404 });

const d = session.data;

const gated = d.access === 'members';
const access = gated
  ? await checkAccess(Astro.cookies.get('sb-token')?.value, d.product)
  : { signedIn: true, entitled: true };
const unlocked = access.entitled; // when !gated, access is already {entitled:true}

const titleCase = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());
const humanise = (slug: string) => titleCase(slug.replace(/-/g, ' '));

type Hold = { name: string; slug: string; img: string; seconds: number; note: string; sideLabel?: string; rebound?: number };
// Poses + holds feed only the unlocked view, so skip the collection read and the
// build entirely for gated non-buyers (they render just the gate card).
let bySlug = new Map<string, any>();
let holds: Hold[] = [];
if (unlocked) {
  const poses = await getCollection('poses');
  bySlug = new Map(poses.map((p) => [p.data.slug, p.data]));
  holds = d.steps.flatMap((s) => {
    const p = bySlug.get(s.pose);
    const base = {
      name: p?.name_en ?? humanise(s.pose),
      slug: s.pose,
      img: p?.images?.[0] ?? '',
      seconds: s.seconds,
      note: s.note ?? p?.cues?.[0] ?? '',
      rebound: s.rebound, // per-pose rebound override, so the timer matches `minutes`
    };
    return s.sides === 2 ? [{ ...base, sideLabel: 'Side 1' }, { ...base, sideLabel: 'Side 2' }] : [base];
  });
}

const holdWords = (secs: number, sides: number) => {
  const base = secs % 60 === 0 ? `${secs / 60} minute${secs === 60 ? '' : 's'}` : `${secs} sec`;
  return sides === 2 ? `${base} each` : base;
};

const kindLabel: Record<string, string> = {
  'post-run': 'Post-Run Reset', 'rest-day': 'Rest-Day Deep Stretch', target: 'Target Session',
  'full-reset': 'Full Reset', 'start-here': 'Start Here',
};

// Sign the self-hosted video server-side, only for an unlocked view.
const bunnyEmbed = unlocked && d.bunny_video_id ? signBunnyEmbed(d.bunny_video_id) : null;
---

<CourseLayout
  title={d.seo_title ?? `${d.title} — Yin Yoga with Katie`}
  description={d.seo_description ?? d.intro}
  noindex={d.access === 'members' || d.unlisted}
  section={kindLabel[d.kind] ?? 'Session'}
>
  <div class="wrap sp">
    <header class="sp-head">
      <p class="sp-eyebrow"><a href="/sessions">← All sessions</a></p>
      <h1>{d.title}</h1>
      <div class="sp-chips">
        <span class="sp-chip area">Area · {titleCase(d.area)}</span>
        <span class="sp-chip">~{d.minutes} min</span>
        <span class="sp-chip">{d.hold_label}</span>
        <span class="sp-chip">{titleCase(d.level.replace(/-/g, ' '))}</span>
        <span class="sp-chip">{d.props.length ? d.props.join(', ') : 'No props needed'}</span>
      </div>
    </header>

    {!unlocked ? (
      /* Non-buyer: the ONLY thing rendered below the header. No course material in the HTML. */
      <div class="sp-gate" data-signedin={access.signedIn ? '1' : ''}>
        {access.signedIn ? (
          <div class="sp-gate-card">
            <h3>A member session</h3>
            <p>Your account doesn't include The Runner's Reset yet — join once and every session unlocks, for good.</p>
            <a class="sp-btn" href="/runner-reset">Join The Runner's Reset →</a>
            <p class="sp-gate-alt">Wrong account? <a href="/account">Switch account</a></p>
          </div>
        ) : (
          <div class="sp-gate-card">
            <h3>Sign in to open this session</h3>
            <p>This session is part of The Runner's Reset. Sign in with the email you joined with, and the whole session unlocks.</p>
            <a class="sp-btn" href="/account">Sign in</a>
            <p class="sp-gate-alt">Don't have it yet? <a href="/runner-reset">Join The Runner's Reset →</a></p>
          </div>
        )}
      </div>
    ) : (
      <Fragment>
        {/* 1 · PRACTICE — watch or use the timer */}
        <section class="sp-sec">
          <p class="sp-label"><span class="sp-num">1</span> Practice</p>
          <div class="sp-tabs" role="tablist" aria-label="How to practice">
            <button id="tab-watch" role="tab" aria-selected="true" aria-controls="p-watch">▶ Watch &amp; learn</button>
            <button id="tab-timer" role="tab" aria-selected="false" aria-controls="p-timer">⏱ Practice with the timer</button>
          </div>

          <div class="sp-panel" id="p-watch" role="tabpanel" aria-labelledby="tab-watch">
            {bunnyEmbed ? (
              <div class="sp-video">
                <iframe src={bunnyEmbed} title={`${d.title} — follow-along class`} loading="lazy"
                  allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen />
              </div>
            ) : d.youtube_video_id ? (
              <div class="sp-video">
                <iframe src={`https://www.youtube.com/embed/${d.youtube_video_id}`} title={`${d.title} — follow-along class`} loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen />
              </div>
            ) : (
              <div class="sp-video-slot">
                <span class="sp-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
                <b>Follow-along video coming soon</b>
                <span>Katie's guided class will play here — everything else on the page is ready to practice now.</span>
              </div>
            )}
          </div>

          <div class="sp-panel" id="p-timer" role="tabpanel" aria-labelledby="tab-timer" hidden>
            <RoutinePlayer title={d.title} holds={holds} />
            <p class="sp-hint">For when you know the shapes and just want to flow — screen-free, no narration. A gentle chime moves you between holds.</p>
          </div>
        </section>

        {/* 2 · WHY + HOW + SEE + SCALE */}
        <section class="sp-sec">
          <p class="sp-label"><span class="sp-num">2</span> Why it helps &amp; how to practice</p>
          <div class="sp-grid">
            <div>
              <div class="sp-card">
                <h3>Why this one</h3>
                <p class="muted">{d.why}</p>
                {d.angle && <p class="sp-angle">“{d.angle}”</p>}
              </div>
              <div class="sp-card">
                <h3>How to practice — the shapes</h3>
                {d.steps.map((s, i) => {
                  const p = bySlug.get(s.pose);
                  const name = p?.name_en ?? humanise(s.pose);
                  return (
                    <div class="sp-cue">
                      <span class="n">{i + 1}</span>
                      <div class="body">
                        <h4>
                          <a href={`/poses/${s.pose}`}>{name}</a>
                          {s.sides === 2 && <span class="side"> · each side</span>}
                        </h4>
                        <span class="hold">{holdWords(s.seconds, s.sides)}</span>
                        {s.note && <p>{s.note}</p>}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            <div>
              <div class="sp-card sp-map">
                <BodyMap region={d.body_map} />
              </div>

              {d.scale.length > 0 && (
                <div class="sp-card">
                  <h3>Scale it to you</h3>
                  {d.scale.map((l) => (
                    <div class="sp-lvl"><span class="tag">{l.level}</span><p>{l.note}</p></div>
                  ))}
                </div>
              )}

              {d.when.length > 0 && (
                <div class="sp-card">
                  <h3>When to use it</h3>
                  <ul class="sp-when">{d.when.map((w) => <li>{w}</li>)}</ul>
                </div>
              )}
            </div>
          </div>
        </section>

        <div class="sp-learn">
          <b>Why the page looks like this:</b> everyone learns differently — so every session gives you the <b>video</b> (watch &amp; follow), the <b>timer</b> (practice screen-free once you know it), the <b>why</b> (understand it), <b>written cues</b> (read it) and a <b>body map</b> (see where it works).
        </div>

        {d.access === 'free' && (
          <div class="sp-upsell">
            <p class="sp-upsell-eyebrow">A free class from The Runner's Reset</p>
            <h3>Like how that felt? There's a whole library.</h3>
            <p>A short session for every place running tightens — plus longer Full Resets, guided plans and a deep-rest NSDR — each one a page just like this. Founding price for the first 100 runners.</p>
            <a class="sp-btn" href="/runner-reset">See what's inside The Runner's Reset →</a>
          </div>
        )}
      </Fragment>
    )}
  </div>
</CourseLayout>

<script>
  import { getSupabase, writeSbCookie } from '../../lib/supabaseBrowser';

  // --- Watch / Timer tabs (only present when unlocked) ---
  const tw = document.getElementById('tab-watch');
  const tt = document.getElementById('tab-timer');
  const pw = document.getElementById('p-watch');
  const pt = document.getElementById('p-timer');
  function sel(watch: boolean) {
    tw?.setAttribute('aria-selected', String(watch));
    tt?.setAttribute('aria-selected', String(!watch));
    if (pw) pw.hidden = !watch;
    if (pt) pt.hidden = watch;
  }
  tw?.addEventListener('click', () => sel(true));
  tt?.addEventListener('click', () => sel(false));

  // --- Cookie fallback ---
  // The server gates on the sb-token cookie. If the gate is showing but the
  // browser actually has a live session (e.g. the 1-hour cookie lapsed while the
  // longer-lived local session didn't), sync the cookie and reload once so the
  // server can render the unlocked page. The guard prevents a reload loop.
  const gate = document.querySelector('.sp-gate');
  if (gate) {
    const supabase = getSupabase();
    supabase?.auth.getSession().then(({ data: { session } }) => {
      if (session && sessionStorage.getItem('sp-reload') !== '1') {
        writeSbCookie(session);
        sessionStorage.setItem('sp-reload', '1');
        location.reload();
      }
    });
  } else {
    sessionStorage.removeItem('sp-reload');
  }
</script>

<style>
  .sp { max-width: 960px; }
  .sp-head { padding: 8px 0 6px; }
  .sp-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--gold-solid); }
  .sp-head h1 { margin: 10px 0 0; }
  .sp-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
  .sp-chip { font-size: 12.5px; font-weight: 600; color: var(--ink); background: var(--paper-2); border: 1px solid var(--line); border-radius: 100px; padding: 6px 13px; }
  .sp-chip.area { background: rgba(188,157,154,.24); border-color: transparent; }

  .sp-sec { padding: 26px 0; }
  .sp-label { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--plum-deep); margin-bottom: 14px; display: flex; align-items: center; gap: 9px; }
  .sp-num { width: 22px; height: 22px; border-radius: 50%; background: var(--plum); color: var(--paper); display: inline-flex; align-items: center; justify-content: center; font-size: 12px; }

  .sp-tabs { display: inline-flex; background: var(--paper-2); border: 1px solid var(--line); border-radius: 100px; padding: 4px; margin-bottom: 16px; }
  .sp-tabs button { border: none; background: transparent; font: inherit; font-weight: 600; font-size: 14.5px; color: var(--ink-soft); padding: 9px 18px; border-radius: 100px; cursor: pointer; }
  .sp-tabs button[aria-selected="true"] { background: var(--plum); color: var(--paper); }
  .sp-panel[hidden] { display: none; }

  .sp-video { position: relative; aspect-ratio: 16/9; border-radius: 16px; overflow: hidden; border: 1px solid var(--line); }
  .sp-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .sp-video-slot { aspect-ratio: 16/9; border-radius: 16px; border: 2px dashed rgba(137,73,75,.5); background: var(--paper-2); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 20px; color: var(--ink-soft); }
  .sp-video-slot b { color: var(--ink); font-family: var(--display); font-size: 19px; }
  .sp-play { width: 62px; height: 62px; border-radius: 50%; background: rgba(137,73,75,.16); display: flex; align-items: center; justify-content: center; }
  .sp-play svg { width: 24px; height: 24px; fill: var(--gold-solid); margin-left: 4px; }
  .sp-hint { font-size: 12.5px; color: var(--ink-soft); font-style: italic; text-align: center; margin-top: 10px; }

  /* Access gate (server-rendered) */
  .sp-gate { margin: 8px 0 40px; }
  .sp-gate-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 16px; padding: 34px 28px; text-align: center; }
  .sp-gate-card h3 { font-family: var(--display); font-weight: 500; font-size: 23px; color: var(--plum); margin-bottom: 8px; }
  .sp-gate-card p { font-size: 15px; color: var(--ink-soft); max-width: 48ch; margin: 0 auto; line-height: 1.6; }
  .sp-btn { display: inline-block; margin-top: 18px; background: #89494B; color: #fff; font-weight: 600; padding: 12px 26px; border-radius: 100px; text-decoration: none; border: none; }
  .sp-btn:hover { background: #6E3A3C; color: #fff; }
  .sp-gate-alt { margin-top: 14px !important; font-size: 13.5px; }
  .sp-gate-alt a { color: var(--gold-solid); font-weight: 600; }

  .sp-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; align-items: start; }
  @media (max-width: 760px) { .sp-grid { grid-template-columns: 1fr; } }
  .sp-card { background: var(--paper-2); border: 1px solid var(--line); border-radius: 16px; padding: 22px 24px; }
  .sp-card + .sp-card { margin-top: 18px; }
  .sp-card h3 { font-size: 20px; margin-bottom: 8px; }
  .sp-card p { font-size: 15px; }
  .sp-card p.muted { color: var(--ink-soft); }
  .sp-angle { margin-top: 12px; font-family: var(--display); font-style: italic; font-size: 16px; color: var(--plum-deep); }

  .sp-cue { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .sp-cue:last-child { border-bottom: none; }
  .sp-cue .n { font-family: var(--display); color: var(--gold); font-size: 20px; width: 22px; flex: none; }
  .sp-cue h4 { font-size: 16px; }
  .sp-cue h4 a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--gold); }
  .sp-cue h4 .side { font-weight: 400; color: var(--ink-soft); font-size: 13px; }
  .sp-cue .hold { font-size: 12.5px; font-weight: 600; color: var(--gold-solid); }
  .sp-cue p { font-size: 14px; color: var(--ink-soft); margin-top: 3px; }

  /* body map lives in components/BodyMap.astro and styles itself */

  .sp-lvl { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .sp-lvl:last-child { border-bottom: none; }
  .sp-lvl .tag { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--paper); background: var(--plum); border-radius: 100px; padding: 4px 10px; height: fit-content; white-space: nowrap; }
  .sp-lvl p { font-size: 14px; color: var(--ink-soft); }

  .sp-when { margin: 0; padding-left: 18px; }
  .sp-when li { margin: 7px 0; color: var(--ink-soft); font-size: 14.5px; }

  .sp-learn { background: rgba(188,157,154,.14); border: 1px solid rgba(188,157,154,.4); border-radius: 14px; padding: 16px 20px; font-size: 14.5px; color: var(--ink); margin: 10px 0 30px; }
  .sp-learn b { color: var(--plum-deep); }

  /* Free-class upsell to the paid library */
  .sp-upsell { text-align: center; background: var(--paper-2); border: 1px solid var(--line); border-radius: 18px; padding: clamp(28px, 4vw, 40px); margin: 0 0 40px; }
  .sp-upsell-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-solid); margin: 0 0 8px; }
  .sp-upsell h3 { font-family: var(--display); font-weight: 500; font-size: clamp(21px, 3vw, 26px); color: var(--plum); margin: 0 0 10px; }
  .sp-upsell p { font-size: 15.5px; color: var(--ink-soft); max-width: 52ch; margin: 0 auto 18px; line-height: 1.6; }
</style>
