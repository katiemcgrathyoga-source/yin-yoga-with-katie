---
export const prerender = false; // SSR: gated like the rest of the course

import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import CourseGate from '../../components/CourseGate.astro';
import { checkAccess } from '../../lib/access';

/**
 * The Runner's Pose Library — one of the bonuses.
 *
 * DERIVED, not hand-listed: the poses here are exactly the ones the sessions
 * use, read from their steps. That's what makes it a runner's library rather
 * than the public directory — and it can never drift out of step with the
 * sessions, because editing a session's steps edits this page.
 *
 * Each pose links to its full public page (cues, cautions, transitions). The
 * curation is the bonus, not a second copy of the content.
 */
const PRODUCT = 'runner-reset';
const access = await checkAccess(Astro.cookies.get('sb-token')?.value, PRODUCT);
const unlocked = access.entitled;

type Entry = { slug: string; name: string; img: string; hold: string; level: string; sessions: string[] };
let entries: Entry[] = [];

if (unlocked) {
  const [sessions, poses] = await Promise.all([getCollection('sessions'), getCollection('poses')]);
  const byPose = new Map<string, Set<string>>();
  for (const s of sessions) {
    // The free class is on the public web; its poses still belong in the library.
    for (const step of s.data.steps) {
      if (!byPose.has(step.pose)) byPose.set(step.pose, new Set());
      byPose.get(step.pose)!.add(s.data.title);
    }
  }
  const titleCase = (v: string) => v.replace(/\b\w/g, (c) => c.toUpperCase());
  entries = poses
    .filter((p) => byPose.has(p.data.slug))
    .map((p) => ({
      slug: p.data.slug,
      name: p.data.name_en,
      img: p.data.images?.[0] ?? `/poses/${p.data.slug}.jpg`,
      hold: p.data.hold_time,
      level: titleCase(p.data.accessibility),
      sessions: [...byPose.get(p.data.slug)!].sort(),
    }))
    .sort((a, b) => a.name.localeCompare(b.name));
}
---

<CourseLayout
  title="The Runner's Pose Library — The Runner's Reset"
  description="Every pose your sessions use, with cues and cautions."
  noindex={true}
  section={unlocked ? 'Pose library' : undefined}
>
  {!unlocked ? (
    <div class="cwrap"><CourseGate signedIn={access.signedIn} thing="the pose library" /></div>
  ) : (
    <div class="cwrap">
      <header class="pl-head">
        <h1>The Runner's Pose Library</h1>
        <p>
          The {entries.length} shapes your sessions actually use — not the whole Yin canon, just the ones
          that matter for a runner's body. Each one opens its full guide: how to get in, what it should
          feel like, what to do if it doesn't, and when to skip it.
        </p>
      </header>

      <ul class="pl-grid">
        {entries.map((p) => (
          <li>
            <a class="pl-card" href={`/poses/${p.slug}`}>
              <img src={p.img} alt={p.name} loading="lazy" width="480" height="360" />
              <div class="pl-body">
                <span class="pl-name">{p.name}</span>
                <span class="pl-meta">{p.hold} · {p.level}</span>
                <span class="pl-in">In: {p.sessions.join(' · ')}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</CourseLayout>

<style>
  .cwrap { max-width: 1040px; margin: 0 auto; padding: 34px 22px 0; }

  .pl-head { margin-bottom: 30px; max-width: 640px; }
  .pl-head h1 { font-family: var(--display); font-size: clamp(30px, 5vw, 40px); margin: 0 0 10px; }
  .pl-head p { color: var(--ink-soft); margin: 0; line-height: 1.7; }

  .pl-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(232px, 1fr));
  }

  .pl-card {
    display: flex; flex-direction: column; height: 100%;
    text-decoration: none; overflow: hidden;
    background: var(--paper-2); border: 1px solid var(--line); border-radius: 14px;
    transition: border-color .16s ease, transform .16s ease;
  }
  .pl-card:hover { border-color: var(--gold-solid); transform: translateY(-2px); }
  .pl-card img { width: 100%; height: 152px; object-fit: cover; display: block; }

  .pl-body { display: flex; flex-direction: column; gap: 5px; padding: 14px 16px 16px; }
  .pl-name { font-family: var(--display); font-size: 18px; color: var(--ink); }
  .pl-meta { font-size: 12.5px; font-weight: 600; color: var(--gold-solid); }
  .pl-in { font-size: 12.5px; color: var(--ink-soft); line-height: 1.45; }
</style>
