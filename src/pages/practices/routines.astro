---
export const prerender = false; // SSR: gated like the rest of the course

import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import CourseGate from '../../components/CourseGate.astro';
import { checkAccess } from '../../lib/access';
import { courseRoutines } from '../../lib/routines';

/**
 * Runner Routines — one of the bonuses.
 *
 * Written for the course; they exist nowhere on the free site, because every
 * public routine surface filters on the `course` field. Timer-led rather than
 * filmed, which is the real difference between a routine and a practice — not
 * length.
 *
 * Ordered short to long: the honest question on a training day is how much time
 * there is, not what a thing is called.
 */
const PRODUCT = 'runner-reset';
const access = await checkAccess(Astro.cookies, PRODUCT);
const unlocked = access.entitled;

const AREA_LABEL: Record<string, string> = {
  hips: 'Hips', hamstrings: 'Hamstrings', quads: 'Quads & outer hip',
  calves: 'Calves & feet', back: 'Back & shoulders', legs: 'Legs', full: 'Full body',
};

let routines: {
  slug: string; title: string; tagline: string; minutes: number;
  level: string; area: string; pose: string;
}[] = [];

if (unlocked) {
  routines = courseRoutines(await getCollection('routines'), PRODUCT)
    .map((r) => ({
      slug: r.data.slug,
      title: r.data.title,
      tagline: r.data.tagline ?? '',
      minutes: r.data.minutes,
      level: r.data.level,
      area: r.data.area ?? 'full',
      pose: r.data.hero_pose ?? r.data.steps[0]?.pose,
    }))
    .sort((a, b) => a.minutes - b.minutes);
}
---

<CourseLayout
  title="Runner Routines — The Runner's Reset"
  description="Timer-led routines written for runners, shortest first."
  noindex={true}
  section={unlocked ? 'Routines' : undefined}
>
  {!unlocked ? (
    <div class="cwrap"><CourseGate signedIn={access.signedIn} thing="your routines" /></div>
  ) : (
    <div class="cwrap">
      <header class="rt-head">
        <h1>Runner Routines</h1>
        <p>
          {routines.length} practices led by the timer rather than a video — for when you know the shapes
          and would rather have quiet than narration. Seven minutes to forty-six, gentle to demanding.
          Shortest first.
        </p>
      </header>

      <ul class="rt-list">
        {routines.map((r) => (
          <li>
            <a class="rt-card" href={`/practices/routines/${r.slug}`}>
              <img src={`/poses/${r.pose}.jpg`} alt="" loading="lazy" width="480" height="360" />
              <div class="rt-body">
                <div class="rt-top">
                  <span class="rt-title">{r.title}</span>
                  <span class="rt-time">~{r.minutes} min</span>
                </div>
                <span class="rt-tagline">{r.tagline}</span>
                <div class="rt-chips">
                  <span class="rt-chip area">{AREA_LABEL[r.area] ?? r.area}</span>
                  <span class="rt-chip">{r.level.replace('-', ' ')}</span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="rt-build">
        <h2>Or build your own</h2>
        <p>Pick the shapes, set the holds, and the timer runs it — useful when you want something none of these covers.</p>
        <a class="rt-build-cta" href="/routines/builder">Open the routine builder →</a>
      </div>
    </div>
  )}
</CourseLayout>

<style>
  .cwrap { max-width: 1040px; margin: 0 auto; padding: 34px 22px 0; }

  .rt-head { margin-bottom: 28px; max-width: 640px; }
  .rt-head h1 { font-family: var(--display); font-size: clamp(30px, 5vw, 40px); margin: 0 0 10px; }
  .rt-head p { color: var(--ink-soft); margin: 0; line-height: 1.7; }

  .rt-list { list-style: none; margin: 0 0 40px; padding: 0; display: grid; gap: 14px; }

  .rt-card {
    display: flex; gap: 16px; align-items: stretch; text-decoration: none; overflow: hidden;
    background: var(--paper-2); border: 1px solid var(--line); border-radius: 14px;
    transition: border-color .16s ease, transform .16s ease;
  }
  .rt-card:hover { border-color: var(--gold-solid); transform: translateY(-2px); }
  .rt-card img { width: 132px; flex: none; object-fit: cover; display: block; }
  @media (max-width: 560px) { .rt-card img { display: none; } }

  .rt-body { display: flex; flex-direction: column; gap: 6px; padding: 15px 18px 16px; }
  .rt-top { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .rt-title { font-family: var(--display); font-size: 19px; color: var(--ink); }
  .rt-time { font-size: 12.5px; font-weight: 600; color: var(--gold-solid); font-variant-numeric: tabular-nums; }
  .rt-tagline { font-size: 14.5px; color: var(--ink-soft); line-height: 1.5; }

  .rt-chips { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 2px; }
  .rt-chip {
    font-size: 11.5px; font-weight: 600; letter-spacing: .04em; text-transform: capitalize;
    padding: 3px 10px; border-radius: 100px; color: var(--ink-soft);
    background: var(--paper); border: 1px solid var(--line);
  }
  .rt-chip.area { background: rgba(188,157,154,.24); border-color: transparent; color: var(--ink); }

  .rt-build { background: var(--paper-2); border: 1px solid var(--line); border-radius: 16px; padding: 24px 26px; margin-bottom: 40px; }
  .rt-build h2 { font-family: var(--display); font-size: 21px; margin: 0 0 8px; }
  .rt-build p { color: var(--ink-soft); margin: 0 0 14px; font-size: 15px; }
  .rt-build-cta { font-weight: 600; color: var(--gold-solid); text-decoration: none; }
  .rt-build-cta:hover { text-decoration: underline; }
</style>
