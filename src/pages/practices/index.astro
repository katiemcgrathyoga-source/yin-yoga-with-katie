---
export const prerender = false; // SSR: the practice list is course material, gated like the practices

import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import CourseGate from '../../components/CourseGate.astro';
import PracticeProgress from '../../components/PracticeProgress.astro';
import { checkAccess } from '../../lib/access';
import { courseRoutines } from '../../lib/routines';

/**
 * The course home — every practice in one place, gated exactly like a practice
 * page so the curriculum isn't sitting in the HTML for people who haven't
 * bought it.
 *
 * Split by LENGTH, not by body area: on a training day the first question is
 * how much time there is. Which area comes second, and the card answers it.
 */
const PRODUCT = 'runner-reset';
const access = await checkAccess(Astro.cookies, PRODUCT);
const unlocked = access.entitled;

const all = await getCollection('practices');
// Unlisted practices are email-only (the free lead magnet) — not part of the index.
const practices = unlocked ? all.filter((p) => !p.data.unlisted) : [];

// The bonuses, so the home page shows everything a buyer owns. Two of the four
// (the routines and the pose library) used to exist only as nav tabs, and a
// member scrolling this page never learned they had them (Kevin, 2026-09-13).
const bonusRoutines = unlocked
  ? courseRoutines(await getCollection('routines'), PRODUCT).sort((a, b) => a.data.minutes - b.data.minutes)
  : [];
// Same derivation as /practices/poses: every shape a practice or routine uses.
const poseCount = new Set(
  [...practices, ...bonusRoutines].flatMap((x) => x.data.steps.map((s) => s.pose)),
).size;

// Only read for the unlocked view; a non-buyer renders just the gate.
const bySlug = new Map(
  (unlocked ? await getCollection('poses') : []).map((p) => [p.data.slug, p.data]),
);

type Practice = (typeof practices)[number];

/** Card thumbnail: an explicit hero pose, else the first shape in the sequence.
 *  A pose photo stands in until each class is filmed and a real still replaces it.
 *
 *  Resolved through the poses collection rather than guessed as `/poses/<slug>.jpg`.
 *  Guessing broke three cards the moment a sequence was reordered onto a pose that
 *  hadn't been photographed yet — a 404 in the grid, with nothing failing the build.
 *  An unphotographed pose now falls back to the branded placeholder. */
const PLACEHOLDER = '/brand/pose-placeholder.png';
const thumb = (p: Practice) => {
  const slug = p.data.hero_pose ?? p.data.steps[0]?.pose;
  return bySlug.get(slug)?.images?.[0] ?? PLACEHOLDER;
};

const LONG_FROM = 30; // minutes — the gap between the ~18 min shorts and the ~50 min resets
const byLength = (a: Practice, b: Practice) => a.data.minutes - b.data.minutes;

const GROUPS = [
  {
    title: 'Short practices',
    blurb: 'Fifteen minutes or so, one area each. Do one right after a run, while you are still warm.',
    items: practices.filter((p) => p.data.minutes < LONG_FROM).sort(byLength),
  },
  {
    title: 'Long practices',
    blurb: 'The whole chain in one unhurried sitting. Made for rest days, when there is no run to recover from.',
    items: practices.filter((p) => p.data.minutes >= LONG_FROM).sort(byLength),
  },
].filter((g) => g.items.length > 0);
---

<CourseLayout
  title="Your practices — The Runner's Reset"
  description="Every practice in The Runner's Reset, in one place."
  noindex={true}
  section={unlocked ? 'Your practices' : undefined}
>
  {!unlocked ? (
    <div class="cwrap"><CourseGate signedIn={access.signedIn} thing="your practices" /></div>
  ) : (
    <div class="cwrap">
      <header class="ch-head">
        {/* The H1 names the PRODUCT, not the section. Someone arriving here has
            just bought something called The Runner's Reset and needs to know
            they're in it — "Your practices" answered a question nobody asked.
            The nav below still says Practices, because within the course that
            word distinguishes filmed classes from Routines and Poses. */}
        <h1>The Runner's Reset</h1>
        <p>Everything you own, in one place. Press play on whichever your body is asking for — there's no order you have to follow, and nothing to fall behind on.</p>
      </header>

      <PracticeProgress />

      <a class="ch-orient" href="/practices/start-here">
        <span class="ch-orient-term">New here? Start here</span>
        <span class="ch-orient-body">What Yin is, why it suits runners, and a first fortnight laid out for you. Five minutes of reading.</span>
      </a>

      {GROUPS.map((g) => (
        <section class="ch-sec">
          <h2>{g.title}</h2>
          <p class="ch-blurb">{g.blurb}</p>
          <ul class="ch-grid">
            {g.items.map((p) => (
              <li>
                <a class="ch-card" href={`/practices/${p.data.slug}`}>
                  <img class="ch-thumb" src={thumb(p)} alt="" loading="lazy" width="480" height="360" />
                  <span class="ch-card-body">
                    <span class="ch-card-title">{p.data.title}</span>
                    {p.data.angle && <span class="ch-card-angle" set:html={p.data.angle} />}
                    <span class="ch-card-meta">~{p.data.minutes} min · {p.data.hold_label}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="ch-sec" aria-labelledby="ch-bonus-h">
        <h2 id="ch-bonus-h">Your bonuses</h2>
        <p class="ch-blurb">Included with the course, on top of the practices. Each one also has its own tab at the top.</p>
        <div class="ch-bonus-grid">
          <div class="ch-soon ch-bonus">
            <span class="ch-bonus-eyebrow">Bonus</span>
            <b>{bonusRoutines.length} Runner Routines</b>
            <span>Led by the timer rather than a video, for when you know the shapes and would rather have quiet. Seven minutes to forty-six, one for every runner's need. Each has its body map, and logs to Strava.</span>
            <ul class="ch-bonus-list">
              {bonusRoutines.map((r) => (
                <li><a href={`/practices/routines/${r.data.slug}`}>{r.data.title}</a> <em>{r.data.minutes} min</em></li>
              ))}
            </ul>
            <a href="/practices/routines">Open all the routines →</a>
          </div>

          <div class="ch-soon ch-bonus">
            <span class="ch-bonus-eyebrow">Bonus</span>
            <b>The Runner's Pose Library</b>
            <span>The {poseCount} shapes your practices and routines actually use, with plain cues and cautions. Filter by area and by how deep you want to go, and hold any one on its own.</span>
            <a href="/practices/poses">Open the pose library →</a>
          </div>

          <div class="ch-soon ch-bonus">
            <span class="ch-bonus-eyebrow">Bonus</span>
            <b>The Deep-Rest Reset</b>
            <span>A guided lie-down NSDR to run after any practice or a long run. Two tracks: <strong>NSDR for Runners</strong> (25 min) and a slower <strong>NSDR Visualization</strong>. Pick whichever your evening calls for.</span>
            <a href="/practices/deep-rest-reset">Open the Deep-Rest Reset →</a>
          </div>

          <div class="ch-soon ch-bonus">
            <span class="ch-bonus-eyebrow">Bonus</span>
            <b>Calendar plans</b>
            <span>A plan loaded straight into your calendar, with a quiet nudge when a practice is due. <strong>The 6-Week Foundation</strong> for a gentle on-ramp, <strong>The Weekly Rhythm</strong> to hold three slots forever, and <strong>Race Prep</strong> that counts backwards from race day.</span>
            <a href="/practices/plans">Open the calendar plans →</a>
          </div>
        </div>
      </section>
    </div>
  )}
</CourseLayout>

<style>
  .cwrap { max-width: 1040px; margin: 0 auto; padding: 34px 22px 0; }

  .ch-head { margin-bottom: 30px; max-width: 620px; }
  .ch-head h1 { font-family: var(--display); font-size: clamp(30px, 5vw, 40px); margin: 0 0 10px; }
  .ch-head p { color: var(--ink-soft); margin: 0; }

  /* Orientation banner — one-time reading, so it sits above the library. */
  .ch-orient {
    display: block; text-decoration: none; margin-bottom: 38px;
    padding: 18px 22px; border-radius: 14px;
    background: rgba(188, 157, 154, .16); border: 1px solid rgba(188, 157, 154, .42);
    transition: border-color .16s ease;
  }
  .ch-orient:hover { border-color: var(--gold-solid); }
  .ch-orient-term { display: block; font-family: var(--display); font-size: 19px; color: var(--plum); margin-bottom: 4px; }
  .ch-orient-body { display: block; font-size: 14.5px; color: var(--ink-soft); line-height: 1.55; }

  .ch-sec { margin-bottom: 42px; }
  .ch-sec h2 { font-family: var(--display); font-size: 22px; margin: 0 0 4px; }
  .ch-blurb { color: var(--ink-soft); font-size: 15px; margin: 0 0 18px; max-width: 560px; }

  .ch-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
  }

  .ch-card {
    display: flex; flex-direction: column; height: 100%;
    text-decoration: none; overflow: hidden;
    background: var(--paper-2); border: 1px solid var(--line); border-radius: 14px;
    transition: border-color .16s ease, transform .16s ease;
  }
  .ch-card:hover { border-color: var(--gold-solid); transform: translateY(-2px); }
  .ch-thumb { width: 100%; height: 148px; object-fit: cover; display: block; }
  .ch-card-body { display: flex; flex-direction: column; gap: 7px; flex: 1; padding: 15px 17px 16px; }
  .ch-card-title { font-family: var(--display); font-size: 19px; color: var(--ink); }
  .ch-card-angle { font-size: 14px; color: var(--ink-soft); line-height: 1.5; }
  .ch-card-meta { margin-top: auto; padding-top: 6px; font-size: 13px; color: var(--ink-soft); }

  /* Was a "coming soon" card; now the entry to the plans. Solid border rather
     than dashed, because dashed reads as a placeholder. */
  .ch-soon {
    display: flex; flex-direction: column; gap: 7px; align-items: flex-start;
    padding: 20px 22px; border-radius: 14px;
    background: var(--paper-2); border: 1px solid rgba(137, 73, 75, .32);
  }
  .ch-soon b { font-family: var(--display); font-weight: 500; font-size: 18px; color: var(--plum); }
  .ch-soon span { font-size: 14.5px; color: var(--ink-soft); line-height: 1.6; }
  .ch-soon a { font-size: 14.5px; font-weight: 600; color: var(--gold-solid); text-decoration: none; }
  .ch-soon a:hover { text-decoration: underline; }

  /* The four bonuses as one grid of tiles, each badged, so nobody has to work
     out what they own from the nav. */
  .ch-bonus-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .ch-bonus { height: 100%; }
  .ch-bonus > a { margin-top: auto; }
  .ch-bonus-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-solid); }
  .ch-bonus-list { list-style: none; margin: 2px 0 6px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13.5px; line-height: 1.5; }
  .ch-bonus-list a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--gold); }
  .ch-bonus-list a:hover { color: var(--plum); }
  .ch-bonus-list em { font-style: normal; font-size: 12.5px; color: var(--ink-soft); }

  .ch-soon-media { flex-direction: row; align-items: flex-start; }
  .ch-soon-img { width: 84px; height: 84px; border-radius: 12px; object-fit: cover; flex: none; }
  .ch-soon-text { display: flex; flex-direction: column; gap: 7px; align-items: flex-start; }
  @media (max-width: 480px) { .ch-soon-media { flex-direction: column; } }
</style>
