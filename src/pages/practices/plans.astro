---
export const prerender = false; // SSR: gated like the rest of the course

import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import CourseGate from '../../components/CourseGate.astro';
import { checkAccess } from '../../lib/access';
import { courseRoutines } from '../../lib/routines';
import { PLANS, type PlanRef } from '../../data/plans';

/**
 * Calendar plans — the "Never-Skip Scheduler".
 *
 * Plans reference the library by `kind:slug`; this resolves them to real titles,
 * durations and URLs at build time. A dead reference THROWS rather than quietly
 * scheduling nothing — a plan silently missing a session is worse than a failed
 * build, because nobody would notice until a member's calendar was wrong.
 *
 * The .ics is generated in the browser from data already on the page, so a
 * download costs no function invocation.
 */
const PRODUCT = 'runner-reset';
const access = await checkAccess(Astro.cookies, PRODUCT);
const unlocked = access.entitled;

type Resolved = { title: string; minutes: number; url: string };
let library = new Map<PlanRef, Resolved>();

const [practices, routines] = await Promise.all([
  getCollection('practices'),
  getCollection('routines'),
]);
for (const p of practices) {
  library.set(`practice:${p.data.slug}`, {
    title: p.data.title,
    minutes: p.data.minutes,
    url: `/practices/${p.data.slug}`,
  });
}
for (const r of courseRoutines(routines, PRODUCT)) {
  library.set(`routine:${r.data.slug}`, {
    title: r.data.title,
    minutes: r.data.minutes,
    url: `/practices/routines/${r.data.slug}`,
  });
}

// Validate every reference up front, listing ALL failures rather than the first.
const dead: string[] = [];
for (const plan of PLANS) {
  if (plan.schedule.type !== 'dated') continue;
  for (const item of plan.schedule.items) {
    if (!library.has(item.ref)) dead.push(`${plan.slug} → ${item.ref}`);
  }
}
if (dead.length) {
  throw new Error(
    `Calendar plans reference ${dead.length} thing(s) that don't exist:\n  ${dead.join('\n  ')}`,
  );
}

/** Everything the client needs to build an .ics, per plan. */
const payload = PLANS.map((plan) => ({
  slug: plan.slug,
  title: plan.title,
  anchor: plan.anchor,
  schedule:
    plan.schedule.type === 'dated'
      ? {
          type: 'dated' as const,
          items: plan.schedule.items.map((i) => ({
            day: i.day,
            note: i.note,
            ...library.get(i.ref)!,
          })),
        }
      : { type: 'weekly' as const, slots: plan.schedule.slots },
}));

/** Group a dated plan into weeks for display. Race plans count backwards, so
 *  week 1 is the furthest out. */
function weeksOf(plan: (typeof PLANS)[number]) {
  if (plan.schedule.type !== 'dated') return [];
  const days = plan.schedule.items.map((i) => i.day);
  const first = Math.min(...days);
  const out: { label: string; items: typeof plan.schedule.items }[] = [];
  for (let w = 0; w < plan.schedule.weeks + 1; w++) {
    const lo = first + w * 7;
    const items = plan.schedule.items.filter((i) => i.day >= lo && i.day < lo + 7);
    if (!items.length) continue;
    const label =
      plan.anchor === 'race'
        ? lo >= 0
          ? 'After the race'
          : lo >= -7
            ? 'Race week'
            : `${Math.ceil(-lo / 7)} weeks out`
        : `Week ${w + 1}`;
    out.push({ label, items });
  }
  return out;
}

const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
---

<CourseLayout
  title="Calendar plans — The Runner's Reset"
  description="Load a plan straight into your calendar, with a quiet nudge when a practice is due."
  noindex={true}
  section={unlocked ? 'Calendar plans' : undefined}
>
  {!unlocked ? (
    <div class="cwrap"><CourseGate signedIn={access.signedIn} thing="your calendar plans" /></div>
  ) : (
    <div class="cwrap cp">
      <header class="cp-head">
        <h1>Calendar plans</h1>
        <p>
          Pick a plan, choose a date, and it drops into whatever calendar you already use — with a
          quiet nudge when a practice is due. Showing up is the part that actually works, and this is
          the bit that makes showing up automatic.
        </p>
      </header>

      {/* All three plans at a glance, then one opened at a time below. Three
          long sections in a row meant the third plan was a scroll away and
          nobody knew it was there (Kevin, 2026-09-13). The sections start
          [hidden]; the script opens the chosen one and keeps it in the hash so
          a plan can be linked to. Without JS the noscript rule shows them all. */}
      <nav class="cp-tiles" aria-label="Choose a plan">
        {PLANS.map((plan) => (
          <a class="cp-tile" href={`#plan-${plan.slug}`} data-open={plan.slug}>
            <span class="cp-tile-kicker">
              {plan.schedule.type === 'weekly'
                ? 'Ongoing · every week'
                : plan.anchor === 'race'
                  ? `${plan.schedule.weeks} weeks · counts down to race day`
                  : `${plan.schedule.weeks} weeks · from the day you start`}
            </span>
            <b>{plan.title}</b>
            <span class="cp-tile-tag">{plan.tagline}</span>
            <span class="cp-tile-cta">See the plan →</span>
          </a>
        ))}
      </nav>
      <noscript><style is:inline>.cp-plan[hidden] { display: block; }</style></noscript>

      {PLANS.map((plan) => (
        <section class="cp-plan" id={`plan-${plan.slug}`} data-plan={plan.slug} hidden>
          <h2>{plan.title}</h2>
          <p class="cp-tagline">{plan.tagline}</p>
          <p class="cp-blurb">{plan.blurb}</p>

          {plan.schedule.type === 'weekly' ? (
            <ul class="cp-slots">
              {plan.schedule.slots.map((s) => (
                <li>
                  <span class="cp-slot-day">{DAY_NAMES[s.weekday]}</span>
                  <span class="cp-slot-label">{s.label}</span>
                  <span class="cp-slot-note">{s.note}</span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="cp-weeks">
              {weeksOf(plan).map((w) => (
                <div class="cp-week">
                  <span class="cp-week-label">{w.label}</span>
                  <ul>
                    {w.items.map((i) => (
                      <li>
                        <a href={library.get(i.ref)!.url}>{library.get(i.ref)!.title}</a>
                        <span class="cp-min">{library.get(i.ref)!.minutes} min</span>
                        <span class="cp-note">{i.note}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}

          <div class="cp-form">
            <label>
              <span>{plan.anchorLabel}</span>
              <input type="date" data-field="date" />
            </label>
            <label>
              <span>What time suits you?</span>
              <input type="time" data-field="time" value="18:00" />
            </label>
            <button type="button" data-add>Add to my calendar</button>
            <p class="cp-msg" data-msg role="status"></p>
          </div>
          <p class="cp-back"><a href="#plans" data-close>↑ Choose a different plan</a></p>
        </section>
      ))}

      <p class="cp-foot">
        The file works with Apple Calendar, Google Calendar, Outlook and anything else that speaks
        iCalendar. Reminders are set for thirty minutes before — change or clear them in your
        calendar once they're in, they're yours now.
      </p>
    </div>
  )}
</CourseLayout>

<script define:vars={{ payload }}>
  window.__plans = payload;
</script>

<script>
  import { buildIcs, downloadIcs, type IcsEvent } from '../../lib/ics';

  // One plan open at a time, chosen from the tiles and remembered in the hash.
  const tiles = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-open]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-plan]'));
  const open = (slug: string | null, scroll: boolean) => {
    sections.forEach((s) => { s.hidden = s.dataset.plan !== slug; });
    tiles.forEach((t) => {
      if (t.dataset.open === slug) t.setAttribute('aria-current', 'true');
      else t.removeAttribute('aria-current');
    });
    if (scroll) {
      const target = slug ? document.getElementById(`plan-${slug}`) : document.querySelector('.cp-tiles');
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  };
  tiles.forEach((t) => t.addEventListener('click', (e) => {
    e.preventDefault();
    history.replaceState(null, '', `#plan-${t.dataset.open}`);
    open(t.dataset.open!, true);
  }));
  document.querySelectorAll<HTMLAnchorElement>('[data-close]').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    history.replaceState(null, '', location.pathname);
    open(null, true);
  }));
  const fromHash = () => {
    const m = location.hash.match(/^#plan-(.+)$/);
    open(m ? m[1] : null, false);
  };
  window.addEventListener('hashchange', fromHash);
  fromHash();

  const plans = (window as any).__plans as any[];
  if (plans) {
    for (const section of Array.from(document.querySelectorAll<HTMLElement>('[data-plan]'))) {
      const plan = plans.find((p) => p.slug === section.dataset.plan);
      if (!plan) continue;
      const dateEl = section.querySelector<HTMLInputElement>('[data-field="date"]')!;
      const timeEl = section.querySelector<HTMLInputElement>('[data-field="time"]')!;
      const msg = section.querySelector<HTMLElement>('[data-msg]')!;

      section.querySelector('[data-add]')!.addEventListener('click', () => {
        if (!dateEl.value) {
          msg.textContent = 'Pick a date first.';
          return;
        }
        const [y, m, d] = dateEl.value.split('-').map(Number);
        const [hh, mm] = (timeEl.value || '18:00').split(':').map(Number);
        // Constructed in local parts so the event lands at the chosen wall-clock
        // time, matching the floating times the .ics writes.
        const anchor = new Date(y, m - 1, d, hh, mm, 0);
        const origin = location.origin;
        const events: IcsEvent[] = [];

        if (plan.schedule.type === 'dated') {
          plan.schedule.items.forEach((i: any, n: number) => {
            const when = new Date(anchor);
            when.setDate(when.getDate() + i.day);
            events.push({
              uid: `${plan.slug}-${n}-${when.getTime()}@yinyogawithkatie.com`,
              start: when,
              durationMinutes: i.minutes,
              summary: `Yin: ${i.title}`,
              description: `${i.note}\n\n${origin}${i.url}`,
              url: `${origin}${i.url}`,
              reminderMinutes: 30,
            });
          });
        } else {
          plan.schedule.slots.forEach((s: any, n: number) => {
            const when = new Date(anchor);
            // Forward to the first matching weekday on or after the chosen date.
            when.setDate(when.getDate() + ((s.weekday - when.getDay() + 7) % 7));
            events.push({
              uid: `${plan.slug}-${n}-${when.getTime()}@yinyogawithkatie.com`,
              start: when,
              durationMinutes: 30,
              summary: `Yin: ${s.label}`,
              description: `${s.note}\n\n${origin}/practices`,
              url: `${origin}/practices`,
              rrule: 'FREQ=WEEKLY',
              reminderMinutes: 30,
            });
          });
        }

        downloadIcs(`${plan.slug}.ics`, buildIcs(`${plan.title} — Yin Yoga with Katie`, events));
        msg.textContent = `Downloaded ${events.length} ${events.length === 1 ? 'entry' : 'entries'}. Open the file to add them.`;
      });
    }
  }
</script>

<style>
  .cwrap { max-width: 1040px; margin: 0 auto; padding: 34px 22px 0; }
  .cp { max-width: 800px; }

  .cp-head { margin-bottom: 34px; }
  .cp-head h1 { font-family: var(--display); font-size: clamp(30px, 5vw, 40px); margin: 0 0 10px; }
  .cp-head p { color: var(--ink-soft); margin: 0; line-height: 1.7; }

  .cp-tiles { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 26px; }
  .cp-tile {
    display: flex; flex-direction: column; gap: 6px; text-decoration: none;
    padding: 20px 22px; border-radius: 16px;
    background: var(--paper-2); border: 1.5px solid var(--line);
    transition: border-color .16s ease, transform .16s ease;
  }
  .cp-tile:hover { border-color: var(--gold-solid); transform: translateY(-2px); }
  .cp-tile[aria-current="true"] { border-color: var(--gold-solid); box-shadow: 0 0 0 3px rgba(137, 73, 75, .12); }
  .cp-tile-kicker { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gold-solid); }
  .cp-tile b { font-family: var(--display); font-weight: 500; font-size: 20px; color: var(--plum); line-height: 1.2; }
  .cp-tile-tag { font-size: 14px; color: var(--ink-soft); line-height: 1.5; }
  .cp-tile-cta { margin-top: auto; padding-top: 8px; font-size: 14px; font-weight: 600; color: var(--gold-solid); }
  .cp-back { margin: 18px 0 0; font-size: 14px; }
  .cp-back a { color: var(--gold-solid); font-weight: 600; text-decoration: none; }

  .cp-plan { background: var(--paper-2); border: 1px solid var(--line); border-radius: 18px; padding: 26px 28px; margin-bottom: 26px; scroll-margin-top: 16px; }
  .cp-plan h2 { font-family: var(--display); font-size: 24px; margin: 0 0 4px; }
  .cp-tagline { font-family: var(--display); font-style: italic; color: var(--plum-deep); margin: 0 0 12px; }
  .cp-blurb { color: var(--ink-soft); line-height: 1.7; margin: 0 0 22px; }

  .cp-weeks { display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px; }
  .cp-week-label { display: block; font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gold-solid); margin-bottom: 6px; }
  .cp-week ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .cp-week li { padding-left: 14px; border-left: 2px solid var(--line); }
  .cp-week li a { font-weight: 600; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--gold); }
  .cp-min { font-size: 12.5px; color: var(--gold-solid); font-weight: 600; margin-left: 8px; font-variant-numeric: tabular-nums; }
  .cp-note { display: block; font-size: 14px; color: var(--ink-soft); line-height: 1.5; margin-top: 2px; }

  .cp-slots { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .cp-slots li { padding-left: 14px; border-left: 2px solid var(--line); }
  .cp-slot-day { font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gold-solid); }
  .cp-slot-label { display: block; font-family: var(--display); font-size: 18px; color: var(--ink); }
  .cp-slot-note { display: block; font-size: 14px; color: var(--ink-soft); line-height: 1.5; margin-top: 2px; }

  .cp-form { display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap; padding-top: 20px; border-top: 1px solid var(--line); }
  .cp-form label { display: flex; flex-direction: column; gap: 5px; font-size: 13px; color: var(--ink-soft); font-weight: 600; }
  .cp-form input {
    font: inherit; font-size: 15px; padding: 10px 12px; border-radius: 10px;
    border: 1.5px solid var(--ink-soft); background: var(--paper); color: var(--ink);
  }
  .cp-form input:focus { outline: 2px solid var(--gold-solid); outline-offset: 1px; border-color: var(--gold-solid); }
  .cp-form button {
    font: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
    padding: 12px 24px; border-radius: 100px; border: none;
    background: var(--gold-solid); color: var(--paper);
  }
  .cp-form button:hover { background: var(--plum-deep); }
  .cp-msg { flex-basis: 100%; margin: 4px 0 0; font-size: 13.5px; color: var(--ink-soft); }

  .cp-foot { font-size: 14px; color: var(--ink-soft); line-height: 1.6; margin: 0 0 40px; }
</style>
