---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import classStill from '../assets/post-run-reset-still.jpg';

// Branded OG card for shares.
const ogImage = new URL('/og/card.png', Astro.site);
ogImage.searchParams.set('t', 'A free Post-Run Reset for runners');
ogImage.searchParams.set('s', '15 minutes of Yin to loosen tight hips, glutes & hamstrings — free');

// Dedicated "Runners" MailerLite form (account 2503148). Separate from the
// retreat form used on /free-class, so runner signups trigger the Post-Run Reset
// automation (delivery + bridge email) and NOT the 2-hour-retreat series.
// `signup_source: "runner"` is still sent as a custom field for reporting.
const ML_ACTION = 'https://assets.mailerlite.com/jsonp/2503148/forms/194288582398052179/subscribe';
---

<BaseLayout
  title="A Free 15-Minute Post-Run Reset for Runners — Yin Yoga with Katie"
  description="Free for runners: a 15-minute follow-along Yin Post-Run Reset — one long, easy hold for each place a run tightens, from the hips and glutes to the hamstrings and spine. Pop in your email and I'll send it — yours to keep."
  image={ogImage.href}
  noindex={true}
>
  <div class="wrap">
    <header class="hero">
      <p class="eyebrow">For runners — free</p>
      <h1>The fifteen minutes after your run that keep you running.</h1>
    </header>

    <p class="page-intro">
      Pop your email in and I'll send you a free follow-along Post-Run Reset — fifteen quiet minutes to
      loosen what running tightens — hips, glutes, hamstrings and spine — so the
      stiffness lets go before it settles in. Yours to keep, for any run, forever.
    </p>

    {/* One image, and it's a frame from the actual class rather than a stock shot
        or a product screenshot: it previews exactly what the email delivers and
        carries Katie's face, which is what the whole channel runs on. Above the
        form, never between the form and its button. */}
    <figure class="lm-still">
      <Image src={classStill} alt="Katie holding Sleeping Swan on her mat during the Post-Run Reset class" widths={[520, 760, 1040]} sizes="(max-width: 560px) 92vw, 520px" loading="eager" fetchpriority="high" />
    </figure>

    {/* The form comes BEFORE the bullets. The headline and the still already make
        the offer; anyone who's convinced shouldn't have to scroll past four
        reassurances to act. The bullets stay below for anyone who isn't yet. */}
    <section class="lm">
      <form
        class="lm-form"
        id="lm-form"
        action={ML_ACTION}
        method="post"
        target="ml_frame"
        aria-label="Get your free Post-Run Reset"
      >
        <label class="sr-only" for="lm-name">First name</label>
        <input
          id="lm-name"
          type="text"
          name="fields[name]"
          placeholder="First name"
          autocomplete="given-name"
          required
          aria-required="true"
        />
        <label class="sr-only" for="lm-email">Email address</label>
        <input
          id="lm-email"
          type="email"
          name="fields[email]"
          placeholder="you@email.com"
          autocomplete="email"
          required
          aria-required="true"
        />
        <input type="hidden" name="fields[signup_source]" value="runner" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button type="submit" class="btn-cta">Send me the Post-Run Reset →</button>
      </form>

      <p class="lm-fine">No spam, ever. Unsubscribe any time. I'll only send Yin.</p>

      <ul class="lm-points">
        <li>A short, follow-along Yin routine — made to do right after a run, while you're warm</li>
        <li>One long, easy hold for each place a run tightens: hips, glutes, hamstrings and spine</li>
        <li>No flexibility needed, no props, no experience — you only ever go to about 60–80% of your capacity</li>
        <li>Fifteen minutes, whenever you like — nothing to keep up with</li>
      </ul>

      <div class="lm-success" id="lm-success" hidden role="status">
        <h2>Check your inbox</h2>
        <p>
          Your Post-Run Reset is on its way. Roll out your mat after your next run and follow along.
          If it isn't there in a minute or two, peek in your promotions or spam folder so you don't
          miss it.
        </p>
        <a class="lm-success-link" href="/">← Explore the free class library</a>
      </div>
    </section>

    <iframe name="ml_frame" id="ml_frame" class="lm-frame" title="Sign-up" tabindex="-1" aria-hidden="true"></iframe>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('lm-form') as HTMLFormElement | null;
  const success = document.getElementById('lm-success');
  const fine = document.querySelector('.lm-fine') as HTMLElement | null;
  const points = document.querySelector('.lm-points') as HTMLElement | null;
  form?.addEventListener('submit', () => {
    // The POST goes to MailerLite in the hidden iframe; show our own thank-you.
    setTimeout(() => {
      form.hidden = true;
      if (fine) fine.hidden = true;
      if (points) points.hidden = true; // the pitch is over once they've signed up
      if (success) success.hidden = false;
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }, 350);
  });
</script>
