---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildPinInventory, pinGaps, type Pin, type PinKind } from '../lib/pinInventory';
import { saveUrl } from '../lib/pinSchedule';

/**
 * Browse every pin the system can make, grouped by the page it points at.
 *
 * The companion to /pincalendar: the calendar decides for you, this is for when
 * you want something specific — a pin for the post you just published, or a
 * second creative for a page that is doing well. Same inventory, same
 * descriptions, same save buttons; only the ordering differs.
 *
 * Private and noindex.
 */
const inventory = await buildPinInventory();

const gaps = await pinGaps();

const SECTIONS: { kind: PinKind; title: string; blurb: string }[] = [
  { kind: 'offer', title: 'The offers', blurb: 'The two pages that capture an email. Worth about one pin in five.' },
  { kind: 'journal', title: 'Journal', blurb: 'The highest-intent pins — they land on a page with a signup on it. Panel leads on the title, Immersive on the idea.' },
  { kind: 'routine', title: 'Routines', blurb: 'Frame says what it is — length, level, a sentence. Panel says why you want it.' },
  { kind: 'pose', title: 'Poses', blurb: 'The everyday backbone. Plate says what it does, Immersive says how it feels.' },
  { kind: 'video', title: 'Classes on YouTube', blurb: 'The only pins whose job is a click rather than a save.' },
];

/** Group a section's pins by the page they point at, keeping page order stable. */
function byPage(kind: PinKind): { label: string; url: string; pins: Pin[] }[] {
  const groups = new Map<string, { label: string; url: string; pins: Pin[] }>();
  for (const pin of inventory) {
    if (pin.kind !== kind) continue;
    const group = groups.get(pin.url) ?? { label: pin.label, url: pin.url, pins: [] };
    group.pins.push(pin);
    groups.set(pin.url, group);
  }
  return [...groups.values()].sort((a, b) => a.label.localeCompare(b.label));
}

const sections = SECTIONS.map((s) => ({ ...s, groups: byPage(s.kind) }));
---

<BaseLayout title="Pin console" description="Every pin the system can make" noindex={true}>
  <div class="pk">
    <header class="pk-head">
      <p class="pk-eyebrow">Pinterest · private</p>
      <h1>Pin console</h1>
      <p class="pk-lede">
        Every pin the system can make, grouped by where it lands. For the daily
        plan, use <a href="/pincalendar">the calendar</a> instead.
      </p>
      <p class="pk-stats">
        <strong>{inventory.length}</strong> pins ·
        {sections.map((s) => `${s.groups.length} ${s.kind}`).join(' · ')} ·
        every one carries a photograph
      </p>
      {gaps.length > 0 && (
        <p class="pk-gaps">
          <strong>{gaps.length} poses aren't in here yet</strong> — they have no
          photograph, and a pin without one is just a sentence on a cream
          background. They join the day they're shot: {gaps.join(', ')}.
        </p>
      )}
    </header>

    {sections.map((section) => (
      <section class="pk-section">
        <div class="pk-section-head">
          <h2>{section.title}</h2>
          <p>{section.blurb}</p>
        </div>

        {section.groups.map((group) => (
          <details class="pk-group">
            <summary>
              <span class="pk-title">{group.label}</span>
              <span class="pk-count">{group.pins.length} pins</span>
            </summary>
            <div class="pk-strip">
              {group.pins.map((pin) => (
                <figure class="pk-pin">
                  <a href={pin.image} target="_blank" rel="noopener">
                    <img src={pin.image} alt="" loading="lazy" width="1000" height="1500" />
                  </a>
                  <figcaption>
                    <span class="pk-tpl">{pin.template} · {pin.tone}</span>
                    <span class="pk-board">{pin.board}</span>
                    <span class="pk-actions">
                      <a class="pk-btn pk-btn-go" href={saveUrl(pin)} target="_blank" rel="noopener">Save</a>
                      <button class="pk-btn" type="button" data-copy={pin.description}>Copy text</button>
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </details>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .pk { max-width: 72rem; margin: 0 auto; padding: 2rem 1rem 5rem; }
  .pk-head { margin-bottom: 2.5rem; }
  .pk-eyebrow {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent); margin: 0 0 0.5rem;
  }
  .pk-head h1 { margin: 0 0 0.5rem; }
  .pk-lede { font-size: 1.05rem; color: var(--muted); margin: 0 0 0.75rem; }
  .pk-stats { font-size: 0.85rem; color: var(--muted); margin: 0; }
  .pk-gaps {
    font-size: 0.82rem; line-height: 1.55; color: var(--muted);
    margin: 0.8rem 0 0; padding: 0.65rem 0.9rem;
    border-left: 2px solid var(--accent);
  }
  .pk-gaps strong { color: var(--ink); }

  .pk-section { margin-bottom: 3rem; }
  .pk-section-head { padding-bottom: 0.6rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--line); }
  .pk-section-head h2 { margin: 0 0 0.15rem; font-size: 1.35rem; }
  .pk-section-head p { margin: 0; font-size: 0.85rem; color: var(--muted); }

  .pk-group { border-bottom: 1px solid var(--line); }
  .pk-group summary {
    display: flex; align-items: baseline; gap: 0.75rem;
    padding: 0.7rem 0; cursor: pointer; list-style: none;
  }
  .pk-group summary::-webkit-details-marker { display: none; }
  .pk-group summary::before { content: '+'; color: var(--accent); font-weight: 600; }
  .pk-group[open] summary::before { content: '−'; }
  .pk-title { font-weight: 600; }
  .pk-count { font-size: 0.78rem; color: var(--muted); }

  .pk-strip {
    display: flex; gap: 1rem; overflow-x: auto; padding: 0.25rem 0 1rem;
    -webkit-overflow-scrolling: touch;
  }
  .pk-pin { margin: 0; flex: 0 0 132px; }
  .pk-pin img {
    width: 132px; height: 198px; object-fit: cover; display: block;
    border-radius: 4px; background: var(--img-bg, #f0e7dc);
  }
  .pk-pin figcaption { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.4rem; }
  .pk-tpl { font-size: 0.72rem; font-weight: 600; color: var(--ink); }
  .pk-board { font-size: 0.68rem; color: var(--muted); }
  .pk-actions { display: flex; gap: 0.3rem; margin-top: 0.2rem; }
  .pk-btn {
    font: inherit; font-size: 0.7rem; font-weight: 600;
    padding: 0.25rem 0.6rem; border-radius: 999px;
    border: 1px solid var(--line); background: transparent; color: var(--ink);
    cursor: pointer; text-decoration: none;
  }
  .pk-btn:hover { border-color: var(--accent); color: var(--accent); }
  .pk-btn-go { background: var(--accent); border-color: var(--accent); color: var(--pg); }
  .pk-btn-go:hover { opacity: 0.9; color: var(--pg); }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = "Couldn't copy";
      }
      setTimeout(() => { button.textContent = 'Copy text'; }, 1600);
    });
  }
</script>
