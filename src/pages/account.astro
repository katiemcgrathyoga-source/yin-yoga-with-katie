---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
// A photograph, not a video still. The still was a soft frame from the class and
// the tile's narrow crop took Katie's head off the top of it; this is cropped
// square around her head and heart so any tile shape still lands on her.
import courseStill from '../assets/course-tile.jpg';

// Member account + magic-link sign-in (Phase 1). Private surface: noindex +
// excluded from the sitemap. All logic is client-side against Supabase Auth;
// the page renders both states and the script reveals the right one.
//
// IMPORTANT: everything the script fills in must be rendered HERE, in the
// template, and only shown/hidden by the script. Astro scopes the styles below
// with a data-astro-cid attribute stamped on elements AT BUILD TIME — markup
// injected later via innerHTML never gets that attribute, so its styles simply
// don't apply. That is what turned the owned-product card into unstyled text.

// Counted at build time so the tile can't promise a number the library doesn't
// have. Unlisted practices are the email-only free class, not part of the course.
const practiceCount = (await getCollection('practices')).filter((p) => !p.data.unlisted).length;
---

<BaseLayout
  title="Your account — Yin Yoga with Katie"
  description="Sign in to your Yin Yoga with Katie account."
  noindex={true}
>
  <div class="wrap acct">
    <h1 class="acct-h1">Your account</h1>

    <p id="acct-thanks" class="acct-thanks" hidden>
      Thank you for joining The Runner's Reset. Sign in below with the same email you
      used at checkout to unlock it — we'll send you a one-tap link.
    </p>

    {/* Shown until we know the auth state, and if Supabase isn't configured. */}
    <p id="acct-loading" class="acct-note">Loading…</p>
    <p id="acct-unconfigured" class="acct-note" hidden>Accounts aren't switched on yet. Check back soon.</p>

    {/* Signed-out: magic-link form */}
    <section id="acct-signin" class="acct-card" hidden>
      <h2 class="acct-h2">Sign in</h2>
      <p class="acct-sub">Enter your email and we'll send you a one-tap sign-in link — no password to remember.</p>
      <form id="acct-form" class="acct-form">
        <label class="sr-only" for="acct-email">Email address</label>
        <input id="acct-email" class="acct-input" type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
        <button class="acct-btn" type="submit">Send me a link</button>
      </form>
      <p id="acct-msg" class="acct-msg" role="status" aria-live="polite"></p>
    </section>

    {/* Signed-in: identity + what they own */}
    <section id="acct-in" class="acct-card" hidden>
      <h2 class="acct-h2">You're signed in</h2>
      <p class="acct-sub">Signed in as <strong id="acct-who"></strong>.</p>

      <p id="acct-ents-h" class="acct-ents-h" hidden>What you own</p>

      {/* The owned course, as the thing it is. A text link asked someone who has
          just paid to work out that "practices" is what they bought. */}
      <a id="acct-tile" class="acct-tile" href="/practices" hidden>
        <span class="acct-tile-img">
          <Image src={courseStill} alt="" width={440} height={440} loading="eager" />
        </span>
        <span class="acct-tile-body">
          <span class="acct-tile-eyebrow">Your course</span>
          <span class="acct-tile-title" id="acct-tile-title">The Runner's Reset</span>
          <span class="acct-tile-meta" id="acct-tile-meta">
            {practiceCount} practices, plus poses, routines and calendar plans
          </span>
          <span class="acct-tile-cta">Enter the course <span aria-hidden="true">→</span></span>
        </span>
      </a>

      {/* Anything else on the account, and the nothing-yet state. */}
      <ul id="acct-ents-list" class="acct-ents-list" hidden></ul>
      <div id="acct-empty" hidden>
        <p class="acct-ents-empty">No purchases on this account yet.</p>
        <a class="acct-browse" href="/runner-reset">See what's inside The Runner's Reset →</a>
      </div>

      <button id="acct-out" class="acct-btn acct-btn-quiet" type="button">Sign out</button>
    </section>
  </div>
</BaseLayout>

<script>
  import { getSupabase } from '../lib/supabaseBrowser';

  const $ = (id: string) => document.getElementById(id);
  const show = (id: string, on = true) => { const el = $(id); if (el) el.hidden = !on; };

  // Post-checkout thank-you (Polar redirect returns ?purchased=1).
  if (new URLSearchParams(location.search).get('purchased') === '1') show('acct-thanks', true);

  const supabase = getSupabase();
  if (!supabase) {
    show('acct-loading', false);
    show('acct-unconfigured', true);
  } else {
    const render = async () => {
      const { data: { session } } = await supabase.auth.getSession();
      show('acct-loading', false);
      if (!session) {
        show('acct-in', false);
        show('acct-signin', true);
        return;
      }
      show('acct-signin', false);
      show('acct-in', true);
      const who = $('acct-who');
      if (who) who.textContent = session.user.email ?? 'your account';

      // RLS returns only this user's rows.
      const { data: ents } = await supabase.from('entitlements').select('product, created_at');
      const owned: string[] = (ents ?? []).map((e: any) => e.product);

      // The course gets the tile; anything else falls back to a plain link. Both
      // are already in the DOM — the script only decides what to show, because
      // markup created here would come out unstyled (see the note in the
      // frontmatter).
      const hasCourse = owned.includes('runner-reset');
      const others = owned.filter((p) => p !== 'runner-reset');

      show('acct-ents-h', owned.length > 0);
      show('acct-tile', hasCourse);
      show('acct-empty', owned.length === 0);

      const list = $('acct-ents-list');
      show('acct-ents-list', others.length > 0);
      if (list) {
        list.replaceChildren(
          ...others.map((p) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = '/';
            a.textContent = p;
            li.append(a);
            return li;
          }),
        );
      }
    };

    // Sign-in form → send magic link back to this page.
    $('acct-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = ($('acct-email') as HTMLInputElement)?.value.trim();
      const msg = $('acct-msg');
      if (!email) return;
      if (msg) msg.textContent = 'Sending…';
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: window.location.href.split('#')[0] },
      });
      if (msg) msg.textContent = error
        ? `Something went wrong: ${error.message}`
        : 'Check your inbox for the sign-in link.';
    });

    $('acct-out')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      render();
    });

    // Re-render on auth changes (including the magic-link redirect completing).
    supabase.auth.onAuthStateChange(() => render());
    render();
  }
</script>

<style>
  .acct { padding: 44px 0 64px; max-width: 560px; }
  .acct-h1 { font-family: var(--display); font-weight: 500; font-size: clamp(30px, 6vw, 40px); color: var(--plum); margin: 0 0 8px; }
  .acct-note { color: var(--ink-soft); }
  .acct-thanks { background: var(--paper-2); border: 1px solid var(--line); border-left: 3px solid var(--gold-solid); border-radius: 0 12px 12px 0; padding: 16px 18px; margin: 16px 0 0; color: var(--ink); line-height: 1.6; }
  .acct-card { margin: 22px 0 0; background: var(--paper-2); border: 1px solid var(--line); border-radius: 18px; padding: clamp(24px, 4vw, 34px); }
  .acct-h2 { font-family: var(--display); font-weight: 500; font-size: 22px; color: var(--plum); margin: 0 0 8px; }
  .acct-sub { color: var(--ink-soft); font-size: 15.5px; line-height: 1.6; margin: 0 0 18px; }
  .acct-form { display: flex; flex-direction: column; gap: 12px; }
  .acct-input { font: inherit; font-size: 16px; padding: 13px 15px; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); }
  .acct-input:focus { border-color: var(--plum); outline: none; }
  .acct-btn { font: inherit; font-weight: 600; font-size: 16px; padding: 13px 22px; border-radius: 12px; border: none; background: var(--plum); color: var(--paper); cursor: pointer; }
  .acct-btn:hover { background: var(--plum-deep); }
  .acct-btn-quiet { background: none; color: var(--ink-soft); border: 1px solid var(--line); margin-top: 18px; }
  .acct-btn-quiet:hover { background: none; border-color: var(--gold-solid); color: var(--gold-solid); }
  .acct-msg { font-size: 14px; color: var(--plum); min-height: 1.2em; margin: 14px 0 0; }
  .acct-ents-h { font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); font-weight: 600; margin: 0 0 10px; }
  .acct-ents-list { margin: 14px 0 0; padding-left: 20px; }
  .acct-ents-list li { margin: 4px 0; }
  .acct-ents-list li a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--gold-solid); }
  .acct-ents-list li a:hover { color: var(--gold-solid); }
  .acct-ents-empty { color: var(--ink-soft); font-size: 15px; margin: 0; }

  /* The course tile — the primary action of this page for anyone who owns it.
     A photo from the practice itself, so the thing you bought is recognisable
     before you've read a word. */
  .acct-tile {
    /* Wider than it was: at 132px the crop was severe enough to lose the subject
       whatever photo went in it. */
    display: grid; grid-template-columns: 168px 1fr; align-items: stretch;
    text-decoration: none; overflow: hidden;
    background: var(--paper); border: 1px solid var(--line); border-radius: 16px;
    transition: border-color .16s ease, transform .16s ease, box-shadow .16s ease;
  }
  .acct-tile:hover {
    border-color: var(--gold-solid); transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(46, 52, 47, .1);
  }
  /* Setting `display` on the tile beats the UA's [hidden] rule, so the hidden
     state has to be restated or the tile shows for people who own nothing. */
  .acct-tile[hidden] { display: none; }
  .acct-tile-img { display: block; position: relative; background: var(--paper-2); }
  .acct-tile-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .acct-tile-body { display: flex; flex-direction: column; gap: 3px; padding: 18px 20px; }
  .acct-tile-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-solid); }
  .acct-tile-title { font-family: var(--display); font-weight: 500; font-size: 21px; color: var(--plum); line-height: 1.2; }
  .acct-tile-meta { font-size: 13.5px; color: var(--ink-soft); line-height: 1.5; }
  .acct-tile-cta { margin-top: 10px; font-size: 14.5px; font-weight: 600; color: var(--gold-solid); }
  .acct-tile:hover .acct-tile-cta span { display: inline-block; transform: translateX(3px); transition: transform .16s ease; }
  @media (max-width: 460px) {
    .acct-tile { grid-template-columns: 1fr; }
    .acct-tile-img { aspect-ratio: 16 / 9; }
  }
  @media (prefers-reduced-motion: reduce) {
    .acct-tile, .acct-tile:hover .acct-tile-cta span { transition: none; transform: none; }
  }
  .acct-browse { display: inline-block; margin-top: 14px; font-weight: 600; font-size: 15px; color: var(--gold-solid); text-decoration: none; }
  .acct-browse:hover { text-decoration: underline; }
</style>
