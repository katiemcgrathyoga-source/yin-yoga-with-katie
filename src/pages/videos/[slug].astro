---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { lenLabel, videoHeadline, videoSubtitle, videoFaq } from '../../lib/video';
import { FOCUS } from '../../lib/videoFacets';
import { AUDIENCES } from '../../data/audiences';
import { SITE } from '../../data/site';
import Cta from '../../components/Cta.astro';
import { journalPinUrl } from '../../lib/journalPin';

/**
 * One reusable template for every video class. `getStaticPaths` emits a static
 * page per file in src/content/videos/, keyed by slug. Everything on the page —
 * thumbnail, pills, chapter links, SEO — is derived from the record, so adding a
 * Markdown file is all it takes to publish a new class.
 */
export async function getStaticPaths() {
  const videos = await getCollection('videos');
  // slug → display name, so chapters can render a proper linked label per pose.
  const poseNames = Object.fromEntries(
    (await getCollection('poses')).map((p) => [p.data.slug, p.data.name_en]),
  );
  // Site rule: no pages for classes under 10 minutes (shorts / promos).
  return videos
    .filter((video) => video.data.length_minutes >= 10)
    .map((video) => ({
      params: { slug: video.data.slug },
      props: { video, poseNames },
    }));
}

const { video, poseNames } = Astro.props;
const d = video.data;
// Runner-tagged classes ask for the runner lead magnet instead of the retreat.
const isRunner = d.intent_tags.includes('runners');
// Every held pose in a chapter (new `poses` array, falling back to the legacy single `pose`).
const chapterPoses = (c: { pose?: string; poses?: string[] }) =>
  c.poses && c.poses.length ? c.poses : c.pose ? [c.pose] : [];
const { Content } = await render(video);

// --- Thumbnail: auto-derived from youtube_id unless a thumbnail is set --------
const isCustomThumb = Boolean(d.thumbnail && d.thumbnail.trim());
const thumb = isCustomThumb
  ? d.thumbnail!
  : `https://img.youtube.com/vi/${d.youtube_id}/maxresdefault.jpg`;
const thumbFallback = `https://img.youtube.com/vi/${d.youtube_id}/hqdefault.jpg`;

// --- Player links: out to YouTube, never embedded -----------------------------
const watchUrl = `https://www.youtube.com/watch?v=${d.youtube_id}`;
const chapterUrl = (seconds: number) => `${watchUrl}&t=${seconds}s`;

// --- Headline + subtitle: curated fields if set, else derived from the title ---
const headline = videoHeadline(d);
const subtitle = videoSubtitle(d);

// --- Meta pills, all derived from the fields ----------------------------------
// Displayed length prefers the marketed `display_length`, else a rounded minutes
// value; the true `length_minutes` still drives filtering + the JSON-LD duration.
const lengthLabel = lenLabel(d);
const levelLabel =
  d.level === 'all-levels' ? 'All levels' : d.level.charAt(0).toUpperCase() + d.level.slice(1);
const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const needsStrap = d.props.some((p) => /strap/i.test(p) && /required/i.test(p));
const publishedLabel = d.published
  ? new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d.published)
  : null;

// --- Chapters: split "Category · Name (duration)" into its parts ----------------
function parseChapter(title: string) {
  let cat: string | null = null;
  let rest = title;
  const dot = title.indexOf(' · ');
  if (dot !== -1) {
    cat = title.slice(0, dot).trim();
    rest = title.slice(dot + 3).trim();
  }
  let note: string | null = null;
  const paren = rest.match(/^(.*?)\s*\(([^)]*)\)\s*$/);
  if (paren) {
    rest = paren[1].trim();
    note = paren[2].trim();
  }
  return { cat, name: rest, note };
}

// --- schema.org VideoObject, built from the fields ----------------------------
const hours = Math.floor(d.length_minutes / 60);
const mins = d.length_minutes % 60;
const isoDuration = `PT${hours ? `${hours}H` : ''}${mins ? `${mins}M` : ''}` || 'PT0M';
const absThumb = new URL(thumb, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: d.title,
  description: d.seo_description,
  thumbnailUrl: [absThumb],
  ...(d.published ? { uploadDate: d.published.toISOString().slice(0, 10) } : {}),
  duration: isoDuration,
  contentUrl: watchUrl,
  embedUrl: `https://www.youtube.com/embed/${d.youtube_id}`,
  publisher: { '@type': 'Organization', name: 'Yin Yoga with Katie' },
  hasPart: d.chapters.map((c) => ({
    '@type': 'Clip',
    name: parseChapter(c.title).name,
    startOffset: c.seconds,
    url: chapterUrl(c.seconds),
  })),
};

// FAQ (enriched classes only — skeletons stay noindex and thin) + breadcrumb.
const faq = d.enriched ? videoFaq(d) : [];
const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    // The library is /videos now, not the homepage.
    { '@type': 'ListItem', position: 2, name: 'YouTube Classes', item: new URL('/videos', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: videoHeadline(d), item: new URL(`/videos/${d.slug}`, Astro.site).href },
  ],
};

// The hubs this class belongs to. Linking up to them from every class page is
// what makes the library a graph rather than a list: a crawler arriving on any
// class can reach the hubs, and from a hub every other class.
//
// Focus hubs are matched; audience hubs are curated, so membership is simply
// whether this class's slug is on their list.
const hubs = [
  ...FOCUS.filter((f) => f.match(d)).map((f) => ({ key: f.key, heading: f.heading })),
  ...AUDIENCES.filter((a) => a.classes.includes(d.slug)).map((a) => ({ key: a.key, heading: a.heading })),
];
const schema = [jsonLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];

const eyebrow = ['Yin Yoga', ...d.intent_tags.map(capitalise)].join(' · ');

// Canonical pin for the Pinterest save button. Text-led (no photo): a 16:9
// YouTube frame doesn't suit the tall arch crop the way a portrait pose photo
// does, so this keeps the save button working everywhere without ever risking
// a letterboxed thumbnail. Kept separate from the page's og:image (still the
// real YouTube thumbnail via `thumb`), so this only affects the Pinterest share.
const journalPin = journalPinUrl(Astro.site, {
  variant: 'arch',
  title: headline,
  eyebrow: 'The library',
  meta: `${lengthLabel} · ${levelLabel}`,
  excerpt: d.summary,
});
const videoUrl = new URL(`/videos/${d.slug}/`, Astro.site).href;
const pinSave = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(videoUrl)}&media=${encodeURIComponent(journalPin)}&description=${encodeURIComponent(d.summary)}`;
---

<BaseLayout
  title={d.seo_title}
  description={d.seo_description}
  ogTitle={d.title}
  ogDescription={d.summary}
  ogType="video.other"
  image={thumb}
  jsonLd={schema}
  noindex={!d.enriched}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/videos">All classes</a>
      <span aria-hidden="true">›</span>
      <span>{videoHeadline(d)}</span>
    </nav>

    <header class="vhero">
      <p class="eyebrow">{eyebrow}</p>

      <a class="thumb" href={watchUrl} target="_blank" rel="noopener">
        <img
          src={thumb}
          alt={`${headline} — Yin Yoga class, ${d.length_minutes} minutes`}
          width="1280"
          height="720"
          {...(isCustomThumb
            ? {}
            : { onerror: `this.onerror=null;this.src='${thumbFallback}'` })}
        />
        <span class="play"><span></span></span>
      </a>

      <h1>{headline}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}

      <div class="meta">
        <span class="pill strong">{lengthLabel}</span>
        <span class="pill">{levelLabel}</span>
        {d.intent_tags.map((t) => <span class="pill">{capitalise(t)}</span>)}
        {needsStrap && <span class="pill">Strap needed</span>}
        {d.membership && <span class="pill members">Members only</span>}
        {publishedLabel && <span class="pill">{publishedLabel}</span>}
      </div>

      {
        d.membership ? (
          <a class="watch watch-members" href={SITE.membershipUrl} target="_blank" rel="noopener">
            Watch inside the membership
          </a>
        ) : (
          <a class="watch" href={watchUrl} target="_blank" rel="noopener">
            Watch the full class on YouTube
          </a>
        )
      }
    </header>

    {/* Save to Pinterest — sits right under the watch button, because that
        button sends most visitors straight to YouTube in a new tab. Anything
        lower on this page risks never being seen. */}
    <div class="pose-share">
      <a class="pose-pin-btn" href={pinSave} target="_blank" rel="noopener noreferrer" aria-label="Save this class to Pinterest">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C24.007 5.367 18.641.001 12.017.001z"/></svg>
        Save this class
      </a>
    </div>

    {/* A compact ask right at the top, before the watch button carries most
        visitors off to YouTube in a new tab. The full ask lower down (after
        the chapters) is easy to miss once someone's already watching. */}
    <Cta compact offer={isRunner ? 'runners' : 'retreat'}
      source={isRunner ? 'video-top-runner' : 'video-top'}
      eyebrow="Before you go" />

    {/* Blog body — the rendered Markdown */}
    <div class="prose">
      <Content />
    </div>

    {/* Chapters — clickable index; each time deep-links into YouTube, each pose to its page */}
    <section class="chapters-section">
      <h2>What you'll practice</h2>
      <div class="chapters">
        {
          d.chapters.map((c) => {
            const { cat, name, note } = parseChapter(c.title);
            const slugs = chapterPoses(c);
            return (
              <div class="chap">
                <div class="t">
                  <a href={chapterUrl(c.seconds)} target="_blank" rel="noopener">
                    {c.time}
                  </a>
                </div>
                <div class="cbody">
                  {cat && <div class="cat">{cat}</div>}
                  <div class="nm">
                    {slugs.length === 0 ? (
                      name
                    ) : slugs.length === 1 ? (
                      <a href={`/poses/${slugs[0]}`}>{name}</a>
                    ) : (
                      slugs.map((s, i) => (
                        <>
                          {i > 0 && <span class="chap-poses-sep"> · </span>}
                          <a href={`/poses/${s}`}>{poseNames[s] ?? s}</a>
                        </>
                      ))
                    )}
                    {note && <span> · {note}</span>}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
      <p class="chaps-note">
        Tap a time to jump to that moment on YouTube · tap a pose to open its page.
      </p>
    </section>


    {/* Single CTA — the free two-hour retreat (inline email capture) */}
    {/* A runner-tagged class asks for the runner magnet — matched to what they
        came for, and the funnel with a product behind it. Everything else keeps
        the retreat. Driven by the tag, so new runner classes get it for free. */}
    {isRunner ? (
      <Cta offer="runners" source="video-runner"
        body="Enjoyed this one? I'll send you my free 15-Minute Post-Run Reset — a follow-along Yin class for after your run, with a hold timer and written cues. Yours to keep." />
    ) : (
      <Cta source="video"
        body="Enjoyed this class? I'll send you my free two-hour Yin, restorative and Yoga Nidra retreat — two slow hours to properly switch off, yours to keep. Just pop your email in." />
    )}

    {
      faq.length > 0 && (
        <section class="faq-section">
          <h2>Common questions</h2>
          {faq.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )
    }

    {/* More like this — up into the focus hubs, and across to the rest */}
    {hubs.length > 0 && (
      <section class="more-like">
        <h2>More like this</h2>
        <div class="more-links">
          {hubs.map((f) => (
            <a class="more-link" href={`/videos/for/${f.key}`}>{f.heading}</a>
          ))}
        </div>
        <p class="more-back">
          Or browse <a href="/videos">every class in the library</a>.
        </p>
      </section>
    )}

    {/* Gentle-reminder block */}
    <section class="reminder-section">
      <div class="reminder">
        <b>A gentle reminder:</b> Yin asks you to respect your limits, not override them. Come
        out of any pose that feels like pain rather than sensation, ease off if your hands tingle
        or a knee complains, and take your time coming out of the long holds — the body feels
        tender for a moment, and that passes. This practice is about taking good care of your
        body, never pushing it.
      </div>
    </section>

    <footer>
      <p class="src">
        Yin Yoga with Katie · a calmer, more flexible you — one long, slow practice at a time.
      </p>
    </footer>
  </div>
</BaseLayout>
