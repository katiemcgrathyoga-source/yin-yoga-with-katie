---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { derivedThumb, lenLabel, videoHeadline } from '../lib/video';
import { journalPinUrl } from '../lib/journalPin';
import katieHello from '../assets/katie-hello.jpg';

// "Most-loved first": order by lifetime watch-hours, so the classes subscribers
// actually return to (which skews long + silent) lead the library. New files
// appear automatically. Site rule: classes under 10 minutes are shorts/promos.
const videos = (await getCollection('videos'))
  .filter((v) => v.data.length_minutes >= 10)
  .sort((a, b) => (b.data.watch_hours ?? 0) - (a.data.watch_hours ?? 0));
type V = (typeof videos)[number];

// --- Length buckets ----------------------------------------------------------
// Length — displayed longest-first (subscribers prefer longer classes).
const BUCKETS = [
  { key: '60-90', label: '60–90 min', test: (m: number) => m >= 60 },
  { key: '40-60', label: '40–60 min', test: (m: number) => m >= 40 && m < 60 },
  { key: '20-40', label: '20–40 min', test: (m: number) => m >= 20 && m < 40 },
  { key: 'under-20', label: 'Under 20 min', test: (m: number) => m < 20 },
];
const bucketOf = (m: number) => BUCKETS.find((b) => b.test(m))!.key;
const presentBuckets = BUCKETS.filter((b) => videos.some((v) => bucketOf(v.data.length_minutes) === b.key));

// Body-area buckets — used to build the merged Focus filter (below).
const AREA_BUCKETS = [
  { key: 'hips', label: 'Hips', match: (a: string) => /hip|groin/.test(a) },
  { key: 'lower-back', label: 'Lower back', match: (a: string) => /lower back|low back|sacrum/.test(a) },
  { key: 'shoulders', label: 'Neck & shoulders', match: (a: string) => /shoulder|neck|upper back|chest/.test(a) },
];
const areaKeys = (v: V) => {
  const set = new Set<string>();
  for (const raw of v.data.body_areas) {
    const a = raw.toLowerCase();
    for (const b of AREA_BUCKETS) if (b.match(a)) set.add(b.key);
  }
  if (v.data.intent_tags.includes('hips-lower-back')) { set.add('hips'); set.add('lower-back'); }
  return [...set];
};

// --- Focus: intent + body area merged into one filter row (per the design) ----
// Focus — ordered most-popular-first (by watch-hours signal).
const FOCUS = [
  { key: 'sleep', label: 'Sleep', match: (v: V) => v.data.intent_tags.includes('sleep') },
  { key: 'calm', label: 'Stress & calm', match: (v: V) => v.data.intent_tags.some((t) => ['nervous-system', 'stress'].includes(t)) },
  { key: 'hips', label: 'Hips', match: (v: V) => areaKeys(v).includes('hips') },
  { key: 'full-body', label: 'Full body', match: (v: V) => v.data.intent_tags.includes('full-body') },
  { key: 'shoulders', label: 'Neck & shoulders', match: (v: V) => areaKeys(v).includes('shoulders') },
  { key: 'flexibility', label: 'Flexibility', match: (v: V) => v.data.intent_tags.includes('flexibility') },
  { key: 'lower-back', label: 'Lower back', match: (v: V) => areaKeys(v).includes('lower-back') },
];
const focusKeys = (v: V) => FOCUS.filter((f) => f.match(v)).map((f) => f.key);
const focusLabels = (v: V) => FOCUS.filter((f) => f.match(v)).map((f) => f.label);
const presentFocus = FOCUS.filter((f) => videos.some((v) => f.match(v)));

// Format — how the class is taught (a distinct axis from Focus). Silent + Yoga
// Nidra are strong subscriber preferences, so they earn a filter of their own.
const FORMAT = [
  { key: 'silent', label: 'Silent', match: (v: V) => /silent|minimal cues|no.?talking/i.test(v.data.title) },
  { key: 'yoga-nidra', label: 'Yoga Nidra', match: (v: V) => /nidra|nsdr/i.test(v.data.title) },
  { key: 'no-props', label: 'No props', match: (v: V) => v.data.props.length === 0 || v.data.props.every((p) => /^none$/i.test(p)) || /no.?props|without props|prop.?free/i.test(v.data.title) },
];
const formatKeys = (v: V) => FORMAT.filter((f) => f.match(v)).map((f) => f.key);
const presentFormat = FORMAT.filter((f) => videos.some((v) => f.match(v)));

// Signature filmstrip: a marquee of recent thumbnails (decorative, not links).
const stripVideos = videos.slice(0, 10);
const roughCount = Math.max(10, Math.floor(videos.length / 10) * 10);

// Home OG image (og:image + "Pin it"): a text-led arch pin from the handoff.
const ogImage = journalPinUrl(Astro.site, {
  variant: 'arch',
  title: 'Free Yin Yoga with Katie',
  eyebrow: 'Slow down, stretch, rest',
  excerpt: 'full-length classes, pose guides and guided routines — free, and a two-hour retreat to begin.',
});

const ML_ACTION = 'https://assets.mailerlite.com/jsonp/2503148/forms/192665473777665865/subscribe';
---

<BaseLayout
  title="Yin Yoga with Katie — free classes, pose guides & guided routines"
  description="Gentle Yin Yoga with Katie — a growing library of free full-length classes, an illustrated pose guide, and guided follow-along routines. Start with a free two-hour retreat."
  image={ogImage}
>
  {/* ── Hero: lead with the offer ─────────────────────────────────────────── */}
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="eyebrow">Free yin yoga with Katie</p>
      <h1>Gentle Yin Yoga to help you slow down, stretch deeply, and rest.</h1>
      <p class="home-lede">Full-length yin, restorative and yoga nidra classes — free, and yours to keep. New here? Begin with my free two-hour retreat, and I'll show you around from there.</p>
      <form class="home-capture" id="hero-form" action={ML_ACTION} method="post" target="ml_frame_hero">
        <input type="text" name="fields[name]" placeholder="First name" aria-label="First name" />
        <input type="email" name="fields[email]" required placeholder="Your email" aria-label="Your email" />
        <input type="hidden" name="fields[signup_source]" value="home-hero" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button type="submit" class="btn-cta">Send me the retreat →</button>
      </form>
      <p class="home-done" id="hero-done" hidden>Check your inbox — your two-hour retreat is on its way.</p>
      <p class="home-fine">No spam, ever. I'll only send Yin. — Katie</p>
      <iframe name="ml_frame_hero" hidden title="Sign-up" tabindex="-1" aria-hidden="true"></iframe>
    </div>
    <div class="home-hero-img">
      <Image src={katieHello} alt="Katie" width={560} height={440} loading="eager" />
    </div>
  </section>

  {/* ── Start here: a clear on-ramp for new visitors ──────────────────────── */}
  <section class="home-start">
    <p class="eyebrow home-center">New here? Start here</p>
    <div class="home-cards">
      <a class="home-card" href="/blog/yin-yoga-for-beginners">
        <span class="home-num">01</span>
        <h3>New to Yin? Start here</h3>
        <p>A slow, welcoming guide to your first practice — with nothing to keep up with.</p>
        <span class="home-go">Read the guide →</span>
      </a>
      <a class="home-card" href="/poses">
        <span class="home-num">02</span>
        <h3>Learn the poses</h3>
        <p>An illustrated guide to every shape — cues, hold times, and what to feel.</p>
        <span class="home-go">Open the pose guide →</span>
      </a>
      <a class="home-card" href="/routines">
        <span class="home-num">03</span>
        <h3>Follow a guided routine</h3>
        <p>Short on time? Press play and be led through, pose to pose.</p>
        <span class="home-go">Browse routines →</span>
      </a>
    </div>
  </section>

  {/* ── Routines: the distinct, guided-practice draw ──────────────────────── */}
  <section class="home-routines">
    <div class="home-routines-inner">
      <div class="home-routines-copy">
        <p class="eyebrow">Guided · hands-free</p>
        <h2>Be led through your practice — no thinking, no screen-watching.</h2>
        <p>Pick how long you have, press play, and I'll guide you from one pose to the next with gentle timing and a soft chime. Lovely for a silent practice, for when you're short on time, or for when you already know the poses and just want to be carried through them.</p>
        <div class="home-chips">
          <a href="/routines">10 min</a>
          <a href="/routines">20 min</a>
          <a href="/routines">30 min</a>
          <a href="/routines/builder" class="home-chip-ghost">Build your own</a>
        </div>
      </div>
      <a class="home-routines-visual" href="/routines" aria-label="Browse the routines">
        <span class="hr-eyebrow">A guided routine</span>
        <span class="hr-ring" aria-hidden="true"></span>
        <span class="hr-label">Press play — I'll keep time</span>
      </a>
    </div>
  </section>

  {/* ── The Library ───────────────────────────────────────────────────────── */}
  <div class="wrap lib">
    <header class="home-lib-head">
      <p class="eyebrow">The library</p>
      <h2>{roughCount}+ free Yin Yoga classes</h2>
      <p class="lib-sub">Full-length classes to follow along on YouTube, 10 to 90 minutes — filter for what your body needs today.</p>
    </header>

    <div class="lib-strip" aria-hidden="true">
      <div class="lib-strip-track">
        {[...stripVideos, ...stripVideos].map((v) => (
          <img src={derivedThumb(v.data, 'mqdefault')} alt="" loading="lazy" width="176" height="99" />
        ))}
      </div>
    </div>

    <section>
      <div class="filters lib-filters" id="filters">
        <div class="facet">
          <span class="facet-label">Focus</span>
          <div class="chips lib-chiprow">
            {presentFocus.map((f) => (
              <button type="button" class="chip" data-facet="focus" data-value={f.key} aria-pressed="false">{f.label}</button>
            ))}
          </div>
        </div>

        {presentBuckets.length > 0 && (
          <div class="facet">
            <span class="facet-label">Length</span>
            <div class="chips lib-chiprow">
              {presentBuckets.map((b) => (
                <button type="button" class="chip" data-facet="length" data-value={b.key} aria-pressed="false">{b.label}</button>
              ))}
            </div>
          </div>
        )}

        {presentFormat.length > 0 && (
          <div class="facet">
            <span class="facet-label">Format</span>
            <div class="chips lib-chiprow">
              {presentFormat.map((f) => (
                <button type="button" class="chip" data-facet="format" data-value={f.key} aria-pressed="false">{f.label}</button>
              ))}
            </div>
          </div>
        )}

        <div class="filter-meta">
          <button type="button" class="chip chip-clear" id="clear-filters" hidden>Clear filters</button>
          <span class="count" id="result-count" aria-live="polite"></span>
        </div>
      </div>

      <div class="tiles lib-grid" id="tiles">
        {videos.map((v) => (
          <a
            class="tile"
            href={`/videos/${v.data.slug}`}
            data-tile
            data-focus={focusKeys(v).join('|')}
            data-length={bucketOf(v.data.length_minutes)}
            data-format={formatKeys(v).join('|')}
          >
            <div class="tile-thumb">
              <img class="tile-img" src={derivedThumb(v.data)} alt={v.data.title} loading="lazy" width="480" height="270" />
              <span class="tile-len">{lenLabel(v.data)}</span>
              {v.data.membership && <span class="tile-members">Members</span>}
            </div>
            <div class="tile-body">
              <h3 class="tile-name">{videoHeadline(v.data)}</h3>
              {focusLabels(v).length > 0 && (
                <p class="tile-meta">{focusLabels(v).slice(0, 2).join(' · ')}</p>
              )}
            </div>
          </a>
        ))}
      </div>

      <p class="empty" id="empty" hidden>No classes match those filters yet.</p>
      <nav class="lib-pager" id="pager" aria-label="Library pages"></nav>
    </section>
  </div>

  {/* ── Closing email-capture: the free two-hour retreat ──────────────────── */}
  <section class="lib-retreat">
    <div class="rt-inner">
      <p class="eyebrow">a gift from me</p>
      <h2>Two hours to completely switch off</h2>
      <p class="rt-members">✦ A members-only class — free for you</p>
      <form class="rt-form" id="rt-form" action={ML_ACTION} method="post" target="ml_frame_home">
        <input type="email" name="fields[email]" required placeholder="Your email" aria-label="Your email" />
        <input type="hidden" name="fields[signup_source]" value="home-retreat" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button type="submit" class="btn-cta">Send me the free retreat →</button>
      </form>
      <p class="rt-done" id="rt-done" hidden>Check your inbox — your two-hour retreat is on its way.</p>
      <iframe name="ml_frame_home" hidden title="Sign-up" tabindex="-1" aria-hidden="true"></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Offer hero ── */
  .home-hero { max-width: 1080px; margin: 0 auto; padding: 56px 24px 40px; display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 48px; align-items: center; }
  .home-hero h1 { font-family: var(--display); font-weight: 500; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.1; color: var(--plum); margin: 0 0 18px; }
  .home-lede { font-size: 18px; line-height: 1.62; color: var(--ink-soft); max-width: 52ch; margin: 0 0 26px; }
  .home-capture { display: flex; gap: 8px; flex-wrap: wrap; }
  .home-capture input { flex: 1 1 140px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; }
  .home-capture .btn-cta { white-space: nowrap; }
  .home-fine { font-size: 13px; color: var(--ink-soft); margin: 12px 0 0; }
  .home-done { font-size: 15px; color: var(--plum); margin: 12px 0 0; }
  .home-hero-img img { width: 100%; height: 440px; object-fit: cover; object-position: center 40%; border-radius: 18px; display: block; }

  /* ── Start here ── */
  .home-start { max-width: 1080px; margin: 0 auto; padding: 40px 24px; }
  .home-center { text-align: center; }
  .home-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 10px; }
  .home-card { display: block; background: var(--paper-2); border: 1px solid var(--line); border-radius: 16px; padding: 26px; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .home-card:hover { border-color: var(--gold); transform: translateY(-2px); }
  .home-num { font-family: var(--display); font-size: 15px; letter-spacing: .12em; color: var(--gold-solid); }
  .home-card h3 { font-family: var(--display); font-weight: 500; font-size: 21px; color: var(--plum); margin: 6px 0 8px; }
  .home-card p { font-size: 15px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 16px; }
  .home-go { font-size: 14.5px; font-weight: 600; color: var(--gold-solid); }

  /* ── Routines feature ── */
  .home-routines { background: var(--plum); margin-top: 40px; }
  [data-theme="dark"] .home-routines { background: var(--paper-2); }
  .home-routines-inner { max-width: 1080px; margin: 0 auto; padding: 64px 24px; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .home-routines-copy .eyebrow { color: var(--gold); }
  .home-routines-copy h2 { font-family: var(--display); font-weight: 500; font-size: clamp(26px, 3.2vw, 36px); line-height: 1.18; color: var(--paper); margin: 0 0 16px; }
  [data-theme="dark"] .home-routines-copy h2 { color: var(--ink); }
  .home-routines-copy p { font-size: 17px; line-height: 1.6; color: rgba(249,241,234,.86); max-width: 48ch; margin: 0; }
  [data-theme="dark"] .home-routines-copy p { color: var(--ink-soft); }
  .home-chips { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  .home-chips a { border: 1px solid rgba(249,241,234,.42); border-radius: 999px; padding: 8px 18px; font-size: 14.5px; color: var(--paper); text-decoration: none; transition: background .15s, color .15s; }
  .home-chips a:hover { background: var(--paper); color: var(--plum); }
  .home-chip-ghost { opacity: .8; }
  [data-theme="dark"] .home-chips a { border-color: var(--line); color: var(--ink); }
  .home-routines-visual { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; background: rgba(249,241,234,.06); border: 1px solid rgba(249,241,234,.16); border-radius: 20px; padding: 40px 28px; text-decoration: none; transition: background .15s; }
  .home-routines-visual:hover { background: rgba(249,241,234,.1); }
  [data-theme="dark"] .home-routines-visual { background: var(--paper); border-color: var(--line); }
  .hr-eyebrow { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); }
  .hr-ring { width: 118px; height: 118px; border-radius: 50%; border: 5px solid rgba(249,241,234,.22); border-top-color: var(--gold); }
  [data-theme="dark"] .hr-ring { border-color: var(--line); border-top-color: var(--gold-solid); }
  .hr-label { font-size: 15px; color: rgba(249,241,234,.82); }
  [data-theme="dark"] .hr-label { color: var(--ink-soft); }

  /* ── Library head (demoted from H1) ── */
  .home-lib-head { text-align: center; padding: 56px 0 8px; }
  .home-lib-head h2 { font-family: var(--display); font-weight: 500; font-size: clamp(28px, 3.4vw, 38px); color: var(--plum); margin: 6px 0 10px; }

  @media (max-width: 820px) {
    .home-hero, .home-routines-inner { grid-template-columns: 1fr; gap: 28px; }
    .home-hero-img img { height: 300px; }
    .home-cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Client-side faceted filtering + pagination — no framework. OR within a facet, AND across.
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-tile]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-facet]'));
  const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement | null;
  const countEl = document.getElementById('result-count');
  const emptyEl = document.getElementById('empty');
  const pager = document.getElementById('pager')!;
  const grid = document.getElementById('tiles')!;

  const PER_PAGE = 24;
  let page = 1;
  const active: Record<string, Set<string>> = { focus: new Set(), length: new Set(), format: new Set() };
  const split = (v: string | undefined) => (v ? v.split('|').filter(Boolean) : []);

  const matchOf = (tile: HTMLElement) => {
    const okFocus = active.focus.size === 0 || split(tile.dataset.focus).some((v) => active.focus.has(v));
    const okLength = active.length.size === 0 || active.length.has(tile.dataset.length ?? '');
    const okFormat = active.format.size === 0 || split(tile.dataset.format).some((v) => active.format.has(v));
    return okFocus && okLength && okFormat;
  };

  function apply(resetPage = true) {
    if (resetPage) page = 1;
    const anyActive = active.focus.size + active.length.size + active.format.size > 0;
    const matched = tiles.filter(matchOf);
    const pages = Math.max(1, Math.ceil(matched.length / PER_PAGE));
    if (page > pages) page = pages;
    const start = (page - 1) * PER_PAGE;
    const visible = new Set(matched.slice(start, start + PER_PAGE));
    for (const t of tiles) t.hidden = !visible.has(t);

    if (clearBtn) clearBtn.hidden = !anyActive;
    if (emptyEl) emptyEl.hidden = matched.length > 0;
    if (countEl) countEl.textContent = anyActive ? `${matched.length} of ${tiles.length} ${tiles.length === 1 ? 'class' : 'classes'}` : '';
    renderPager(pages);
  }

  function renderPager(pages: number) {
    pager.innerHTML = '';
    if (pages <= 1) return;
    const btn = (label: string, target: number, opts: { disabled?: boolean; current?: boolean } = {}) => {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = label; b.className = 'lib-page' + (opts.current ? ' is-current' : '');
      if (opts.disabled) b.disabled = true;
      if (opts.current) b.setAttribute('aria-current', 'page');
      if (!opts.disabled && !opts.current) b.addEventListener('click', () => { page = target; apply(false); grid.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      return b;
    };
    pager.appendChild(btn('‹', page - 1, { disabled: page === 1 }));
    const nums = new Set([1, pages, page, page - 1, page + 1]);
    let prev = 0;
    for (let i = 1; i <= pages; i++) {
      if (!nums.has(i)) continue;
      if (i - prev > 1) { const e = document.createElement('span'); e.className = 'lib-ellip'; e.textContent = '…'; pager.appendChild(e); }
      pager.appendChild(btn(String(i), i, { current: i === page }));
      prev = i;
    }
    pager.appendChild(btn('›', page + 1, { disabled: page === pages }));
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const facet = chip.dataset.facet!, value = chip.dataset.value!, set = active[facet];
      if (set.has(value)) { set.delete(value); chip.setAttribute('aria-pressed', 'false'); chip.classList.remove('active'); }
      else { set.add(value); chip.setAttribute('aria-pressed', 'true'); chip.classList.add('active'); }
      apply();
    });
  }
  clearBtn?.addEventListener('click', () => {
    for (const key of Object.keys(active)) active[key].clear();
    for (const chip of chips) { chip.setAttribute('aria-pressed', 'false'); chip.classList.remove('active'); }
    apply();
  });
  apply();

  // Email capture (hero + closing) — MailerLite posts to a hidden iframe; swap to success.
  const swap = (formId: string, doneId: string) => {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const done = document.getElementById(doneId);
    form?.addEventListener('submit', () => {
      window.setTimeout(() => { form.hidden = true; if (done) done.hidden = false; }, 400);
    });
  };
  swap('hero-form', 'hero-done');
  swap('rt-form', 'rt-done');
</script>
