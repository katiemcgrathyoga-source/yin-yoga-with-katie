---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoTile from '../components/VideoTile.astro';
import { derivedThumb } from '../lib/video';
import { FOCUS, isClass } from '../lib/videoFacets';
import { journalPinUrl } from '../lib/journalPin';
import katieHello from '../assets/katie-hello.jpg';
import katieAbout from '../assets/katie-about.jpg';

/**
 * The homepage used to BE the library: it rendered a filterable grid linking to
 * all ~317 class pages, ~170 of which are unwritten skeletons that render
 * `noindex`. That made the site's highest-authority page spend most of its links
 * on pages that refuse to be indexed, and left the library as one flat tier with
 * no hierarchy for a crawler to follow. Search Console showed the cost: 152 real
 * URLs "Discovered — currently not indexed", never crawled at all.
 *
 * So the library moved to /videos, and the homepage now shows a preview plus the
 * routes into it. Every class link below is to an enriched, indexable page.
 */
const videos = (await getCollection('videos'))
  .filter((v) => isClass(v.data) && v.data.enriched)
  .sort((a, b) => (b.data.watch_hours ?? 0) - (a.data.watch_hours ?? 0));

// The preview: the most-practised classes, which are the best first impression
// of the library and the strongest pages to pass authority to.
const featured = videos.slice(0, 12);
const presentFocus = FOCUS.filter((f) => videos.some((v) => f.match(v.data)));
const focusCount = (key: string) =>
  videos.filter((v) => FOCUS.find((f) => f.key === key)!.match(v.data)).length;

// Signature filmstrip: a marquee of recent thumbnails (decorative, not links).
const stripVideos = videos.slice(0, 10);
const roughCount = Math.max(10, Math.floor(videos.length / 10) * 10);

// Home OG image (og:image + "Pin it"): a text-led arch pin from the handoff.
const ogImage = journalPinUrl(Astro.site, {
  variant: 'arch',
  title: 'Free Yin Yoga with Katie',
  eyebrow: 'Slow down, stretch, rest',
  excerpt: 'full-length classes, pose guides and guided routines — free, and a two-hour retreat to begin.',
});

// Retreat form — the hero capture (moved up from the foot of the page; see the
// comment on .home-hero below for why the hero no longer forks runner/not-runner).
const ML_ACTION = 'https://assets.mailerlite.com/jsonp/2503148/forms/192665473777665865/subscribe';
// Runners form — now the closing capture. A different MailerLite form because it
// has to trigger the Post-Run Reset automation, not the retreat series.
const ML_RUNNERS = 'https://assets.mailerlite.com/jsonp/2503148/forms/194288582398052179/subscribe';
---

<BaseLayout
  title="Yin Yoga with Katie — free classes, pose guides & guided routines"
  description="Gentle Yin Yoga with Katie — a growing library of free full-length classes, an illustrated pose guide, and guided follow-along routines. Start with a free two-hour retreat."
  image={ogImage}
>
  {/* ── App directory: what an installed-app visitor sees FIRST instead of the
        offer hero below. Someone who already installed the app already converted
        once — the job now is getting them somewhere useful fast, not another
        email ask. Hidden by default; shown only in standalone/installed mode via
        the data-standalone flag BaseLayout sets before paint (same mechanism as
        the light/dark theme flag). A plain browser visitor never sees this. ── */}
  <section class="app-directory">
    <p class="eyebrow home-center">Welcome back</p>
    <div class="app-tiles">
      <a class="app-tile" href="/videos">
        <span class="app-tile-img"><Image src={katieHello} alt="" width={160} height={160} loading="lazy" /></span>
        <span class="app-tile-info">
          <h2>Classes</h2>
          <p>Full-length classes to follow along with — sleep, sore hips, a busy mind, whatever you need today.</p>
        </span>
      </a>
      <a class="app-tile" href="/poses">
        <span class="app-tile-img"><img data-src="/poses/legs-up-the-wall.jpg" alt="" loading="lazy" /></span>
        <span class="app-tile-info">
          <h2>Poses</h2>
          <p>Every shape, with cues, hold times and cautions — plus a built-in timer for holding it yourself.</p>
        </span>
      </a>
      <a class="app-tile" href="/routines">
        <span class="app-tile-img"><img data-src="/poses/reclined-swan.jpg" alt="" loading="lazy" /></span>
        <span class="app-tile-info">
          <h2>Guided Routines</h2>
          <p>Guided sequences that pace you — press play and I'll keep time, pose to pose.</p>
        </span>
      </a>
      <a class="app-tile" href="/blog">
        <span class="app-tile-img"><Image src={katieAbout} alt="" width={160} height={160} loading="lazy" /></span>
        <span class="app-tile-info">
          <h2>The Journal</h2>
          <p>Notes on practice and technique, in my own words.</p>
        </span>
      </a>
    </div>
  </section>
  <script is:inline>
    // The two plain <img> tiles above are only ever visible in standalone mode
    // (see .app-directory's display:none rule below) — but loading="lazy" alone
    // doesn't stop a browser from fetching an unsized <img> hidden by an
    // ancestor's display:none, unlike astro:assets' <Image>, which does. Holding
    // the URL in data-src until we know we're standalone keeps regular visitors
    // from paying for two photos they'll never see.
    if (document.documentElement.dataset.standalone === 'true') {
      document.querySelectorAll('.app-tile-img img[data-src]').forEach((img) => {
        img.src = img.dataset.src;
      });
    }
  </script>

  {/* ── Hero: lead with the offer ─────────────────────────────────────────── */}
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="eyebrow">Free yin yoga with Katie</p>
      <h1>Gentle Yin Yoga to help you slow down, stretch deeply, and rest.</h1>
      <p class="home-lede">Full-length yin, restorative and yoga nidra classes — free, and yours to keep.</p>
      {/* One offer, not a fork. This used to branch runner / not-a-runner right
          here — two decisions stacked before a first-time visitor had even
          oriented, on top of the "start here" chooser right below. The runner
          offer still exists — it now anchors the closing capture at the foot
          of the page instead, and runner-tagged content elsewhere on the site
          links to it directly. This capture is the broad one that suits
          nearly any visitor. */}
      <p class="home-offer"><strong>A gift from me:</strong> my free two-hour Yin, restorative and Yoga Nidra retreat — yours to keep, and to come back to any time.</p>
      <form class="home-capture" id="hero-form" action={ML_ACTION} method="post" target="ml_frame_hero">
        <input type="text" name="fields[name]" placeholder="First name" aria-label="First name" />
        <input type="email" name="fields[email]" required placeholder="Your email" aria-label="Your email" />
        <input type="hidden" name="fields[signup_source]" value="home-hero" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button type="submit" class="btn-cta">Send me the free retreat →</button>
      </form>
      <p class="home-done" id="hero-done" hidden>Check your inbox — your two-hour retreat is on its way.</p>
      <iframe name="ml_frame_hero" hidden title="Sign-up" tabindex="-1" aria-hidden="true"></iframe>
    </div>
    <div class="home-hero-img">
      <Image src={katieHello} alt="Katie" width={560} height={440} loading="eager" />
    </div>
  </section>

  {/* ── Start here: a clear on-ramp for new visitors ──────────────────────── */}
  {/* Two cards, not three. Routines used to get a third card here AND its own
      band immediately below — the same "guided routine" pitch twice in a row.
      The band covers it with more depth (specific lengths, build-your-own)
      than a short card could, so it keeps the routines moment and the card
      list drops to what it doesn't already cover: the beginner guide and the
      pose library. */}
  <section class="home-start">
    <p class="eyebrow home-center">New here? Start here</p>
    <div class="home-cards">
      <a class="home-card" href="/blog/yin-yoga-for-beginners">
        <span class="home-num">01</span>
        <h3>New to Yin? Start here</h3>
        <p>A slow, welcoming guide to your first practice — with nothing to keep up with.</p>
        <span class="home-go">Read the guide →</span>
      </a>
      <a class="home-card" href="/poses">
        <span class="home-num">02</span>
        <h3>Learn the poses</h3>
        <p>An illustrated guide to every shape — cues, hold times, and what to feel.</p>
        <span class="home-go">Open the pose guide →</span>
      </a>
    </div>
  </section>

  {/* ── Routines: the distinct, guided-practice draw ──────────────────────── */}
  <section class="home-routines">
    <div class="home-routines-inner">
      <div class="home-routines-copy">
        <p class="eyebrow">Guided · hands-free</p>
        <h2>Be led through your practice — no thinking, no screen-watching.</h2>
        <p>Pick how long you have, press play, and I'll guide you from one pose to the next with gentle timing and a soft chime. Lovely for a silent practice, for when you're short on time, or for when you already know the poses and just want to be carried through them.</p>
        <div class="home-chips">
          <a href="/routines">20 min</a>
          <a href="/routines">25 min</a>
          <a href="/routines">30 min</a>
          <a href="/routines/builder" class="home-chip-ghost">Build your own</a>
        </div>
      </div>
      <a class="home-routines-visual" href="/routines" aria-label="Browse the routines">
        <span class="hr-eyebrow">A guided routine</span>
        <span class="hr-ring" aria-hidden="true"></span>
        <span class="hr-label">Press play — I'll keep time</span>
      </a>
    </div>
  </section>

  {/* ── The Library ───────────────────────────────────────────────────────── */}
  <div class="wrap lib">
    <header class="home-lib-head">
      <p class="eyebrow">The library</p>
      <h2>{roughCount}+ free Yin Yoga classes</h2>
      <p class="lib-sub">Full-length classes to follow along on YouTube, 10 to 90 minutes. Pick by what your body needs today.</p>
    </header>

    <div class="lib-strip" aria-hidden="true">
      <div class="lib-strip-track">
        {[...stripVideos, ...stripVideos].map((v) => (
          <img src={derivedThumb(v.data, 'mqdefault')} alt="" loading="lazy" width="176" height="99" />
        ))}
      </div>
    </div>

    {/* Browse by need — the routes into the library. These hub pages are what
        people actually search for ("yin yoga for sleep"), and they give the
        library a middle tier so the homepage no longer has to link to every
        class on the site. */}
    <section class="home-focus">
      <div class="home-focus-row">
        {presentFocus.map((f) => (
          <a class="home-focus-chip" href={`/videos/for/${f.key}`}>
            <span class="hfc-label">{f.label}</span>
            <span class="hfc-n">{focusCount(f.key)}</span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="tiles lib-grid">
        {featured.map((v, i) => <VideoTile video={v.data} eager={i < 4} />)}
      </div>

      <p class="home-lib-more">
        <a class="btn-lib" href="/videos">Browse all {videos.length} classes →</a>
      </p>
    </section>
  </div>

  {/* ── Closing email-capture: the runner offer ────────────────────────────
        Used to be the retreat capture (now up in the hero) — this is the
        runner offer that used to fork the hero instead. Someone who clicked
        "Runner's Reset" in the nav and isn't ready to buy has nowhere to leave
        an email on that sales page itself, so this keeps that capture path
        alive on the homepage rather than dropping it. Same copy Cta.astro
        uses for the 'runners' offer elsewhere, for consistency. ── */}
  <section class="lib-retreat">
    <div class="rt-inner">
      <p class="eyebrow">Free for runners</p>
      <h2>The 15-Minute Post-Run Reset</h2>
      <p class="rt-members">✦ A free follow-along class, with a hold timer</p>
      <form class="rt-form" id="rt-form" action={ML_RUNNERS} method="post" target="ml_frame_home">
        <input type="text" name="fields[name]" placeholder="First name" aria-label="First name" />
        <input type="email" name="fields[email]" required placeholder="Your email" aria-label="Your email" />
        <input type="hidden" name="fields[signup_source]" value="home-footer-runner" />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button type="submit" class="btn-cta">Send me the Post-Run Reset →</button>
      </form>
      <p class="rt-done" id="rt-done" hidden>Check your inbox — your Post-Run Reset is on its way.</p>
      <iframe name="ml_frame_home" hidden title="Sign-up" tabindex="-1" aria-hidden="true"></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── App directory (installed-app only — see the comment above the section) ── */
  .app-directory { display: none; }
  :global(html[data-standalone='true']) .app-directory { display: block; }
  :global(html[data-standalone='true']) .home-hero,
  :global(html[data-standalone='true']) .home-start { display: none; }

  .app-directory { max-width: 640px; margin: 0 auto; padding: 28px 20px 12px; }
  .app-tiles { display: flex; flex-direction: column; gap: 14px; margin-top: 16px; }
  .app-tile {
    display: flex; align-items: center; gap: 16px; background: var(--paper-2);
    border: 1px solid var(--line); border-radius: 16px; padding: 12px; text-decoration: none;
    color: inherit; transition: border-color .15s;
  }
  .app-tile:hover { border-color: var(--gold); }
  .app-tile-img { flex: none; width: 72px; height: 72px; border-radius: 12px; overflow: hidden; }
  .app-tile-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .app-tile-info h2 { font-family: var(--display); font-weight: 500; font-size: 18px; color: var(--plum); margin: 0 0 4px; }
  .app-tile-info p { font-size: 14px; line-height: 1.45; color: var(--ink-soft); margin: 0; }

  /* ── Offer hero ── */
  .home-hero { max-width: 1080px; margin: 0 auto; padding: 56px 24px 40px; display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 48px; align-items: center; }
  .home-hero h1 { font-family: var(--display); font-weight: 500; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.1; color: var(--plum); margin: 0 0 18px; }
  .home-lede { font-size: 18px; line-height: 1.62; color: var(--ink-soft); max-width: 52ch; margin: 0 0 26px; }
  .home-capture { display: flex; gap: 8px; flex-wrap: wrap; }
  .home-capture input { flex: 1 1 140px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; }
  .home-capture .btn-cta { background: #89494B; color: #fff; font-weight: 600; font-size: 15px; padding: 13px 26px; border-radius: 100px; border: none; cursor: pointer; white-space: nowrap; transition: background .15s; }
  .home-capture .btn-cta:hover { background: #6E3A3C; color: #fff; }
  /* The runner offer, set apart from the general lede so the hero reads as two
     beats: what the site is, then the one thing to take right now. */
  .home-offer {
    font-size: 16.5px; line-height: 1.6; color: var(--ink); max-width: 52ch;
    margin: 0 0 18px; padding-left: 14px; border-left: 3px solid var(--gold-solid);
  }
  .home-offer strong { color: var(--plum-deep); }
  .home-done { font-size: 15px; color: var(--plum); margin: 12px 0 0; }
  .home-hero-img img { width: 100%; height: 440px; object-fit: cover; object-position: center 40%; border-radius: 18px; display: block; }

  /* ── Start here ── */
  .home-start { max-width: 1080px; margin: 0 auto; padding: 40px 24px; }
  .home-center { text-align: center; }
  .home-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 10px; max-width: 720px; margin-left: auto; margin-right: auto; }
  .home-card { display: block; background: var(--paper-2); border: 1px solid var(--line); border-radius: 16px; padding: 26px; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .home-card:hover { border-color: var(--gold); transform: translateY(-2px); }
  .home-num { font-family: var(--display); font-size: 15px; letter-spacing: .12em; color: var(--gold-solid); }
  .home-card h3 { font-family: var(--display); font-weight: 500; font-size: 21px; color: var(--plum); margin: 6px 0 8px; }
  .home-card p { font-size: 15px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 16px; }
  .home-go { font-size: 14.5px; font-weight: 600; color: var(--gold-solid); }

  /* ── Routines feature — a deep-sage band with light text in BOTH themes.
        (Fixed colors on purpose: the --plum/--paper tokens flip in dark mode,
        which would turn this band light and hide its light text.) ── */
  .home-routines { background: #48544C; margin-top: 40px; }
  .home-routines-inner { max-width: 1080px; margin: 0 auto; padding: 64px 24px; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: center; }
  .home-routines-copy .eyebrow { color: #cbaaa7; }
  .home-routines-copy h2 { font-family: var(--display); font-weight: 500; font-size: clamp(26px, 3.2vw, 36px); line-height: 1.18; color: #F9F1EA; margin: 0 0 16px; }
  .home-routines-copy p { font-size: 17px; line-height: 1.6; color: rgba(249,241,234,.86); max-width: 48ch; margin: 0; }
  .home-chips { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  .home-chips a { border: 1px solid rgba(249,241,234,.42); border-radius: 999px; padding: 8px 18px; font-size: 14.5px; color: #F9F1EA; text-decoration: none; transition: background .15s, color .15s; }
  .home-chips a:hover { background: #F9F1EA; color: #48544C; }
  .home-chip-ghost { opacity: .8; }
  .home-routines-visual { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; background: rgba(249,241,234,.06); border: 1px solid rgba(249,241,234,.16); border-radius: 20px; padding: 40px 28px; text-decoration: none; transition: background .15s; }
  .home-routines-visual:hover { background: rgba(249,241,234,.1); }
  .hr-eyebrow { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #cbaaa7; }
  .hr-ring { width: 118px; height: 118px; border-radius: 50%; border: 5px solid rgba(249,241,234,.22); border-top-color: #cbaaa7; }
  .hr-label { font-size: 15px; color: rgba(249,241,234,.82); }

  /* ── Library head (demoted from H1) ── */
  .home-lib-head { text-align: center; padding: 56px 0 8px; }
  .home-lib-head h2 { font-family: var(--display); font-weight: 500; font-size: clamp(28px, 3.4vw, 38px); color: var(--plum); margin: 6px 0 10px; }

  /* ── Browse-by-need row (links to the /videos/for/* hubs) ── */
  .home-focus { margin: 26px 0 22px; }
  .home-focus-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .home-focus-chip { display: inline-flex; align-items: baseline; gap: 8px; border: 1px solid var(--line); border-radius: 999px; padding: 9px 18px; text-decoration: none; color: var(--ink); font-size: 15px; transition: border-color .15s, color .15s; }
  .home-focus-chip:hover { border-color: var(--gold); color: var(--gold-solid); }
  .hfc-n { font-size: 12.5px; color: var(--ink-soft); }
  .home-focus-chip:hover .hfc-n { color: var(--gold-solid); }

  /* ── "Browse all" — the one route to the full library ── */
  .home-lib-more { text-align: center; margin: 34px 0 0; }
  .btn-lib { display: inline-block; border: 1px solid var(--gold); border-radius: 999px; padding: 13px 30px; font-size: 15.5px; font-weight: 600; color: var(--gold-solid); text-decoration: none; transition: background .15s, color .15s; }
  .btn-lib:hover { background: var(--gold-solid); color: var(--paper); }

  @media (max-width: 820px) {
    .home-hero, .home-routines-inner { grid-template-columns: 1fr; gap: 28px; }
    .home-hero-img img { height: 300px; }
    .home-cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  // The faceted filtering + pagination that used to live here moved to /videos
  // along with the library itself. The homepage shows a fixed preview, so all
  // that's left is the email capture.

  // Email capture (hero + closing) — MailerLite posts to a hidden iframe; swap to success.
  const swap = (formId: string, doneId: string) => {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const done = document.getElementById(doneId);
    form?.addEventListener('submit', () => {
      window.setTimeout(() => { form.hidden = true; if (done) done.hidden = false; }, 400);
    });
  };
  swap('hero-form', 'hero-done');
  swap('rt-form', 'rt-done');
</script>
