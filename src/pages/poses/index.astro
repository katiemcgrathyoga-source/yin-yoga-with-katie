---
import { getCollection } from 'astro:content';
import { publicRoutines } from '../../lib/routines';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cta from '../../components/Cta.astro';
import {
  POSE_AREA_BUCKETS,
  POSE_AREA_TO_HUB,
  assertPoseHubMapping,
  poseAreaKeys,
  poseAreaLabel,
} from '../../lib/poseFacets';
import { FOCUS } from '../../lib/videoFacets';

// Poses are the reference layer beneath the video library. This is their browsable
// index. Ordered by how foundational/common each pose is — measured by how often it
// appears across Katie's classes and routines — so the shapes she teaches most lead,
// and obscure ones fall to the end. Ties break alphabetically.
const refCount = new Map<string, number>();
const bump = (slug: string, n = 1) => refCount.set(slug, (refCount.get(slug) ?? 0) + n);
for (const v of await getCollection('videos')) {
  if (v.data.length_minutes < 10) continue; // ignore removed shorts
  for (const s of v.data.poses_featured) bump(s);
  for (const c of v.data.chapters) if (c.pose) bump(c.pose);
}
for (const r of publicRoutines(await getCollection('routines'))) for (const st of r.data.steps) bump(st.pose);

const poses = (await getCollection('poses')).sort(
  (a, b) =>
    (refCount.get(b.data.slug) ?? 0) - (refCount.get(a.data.slug) ?? 0) ||
    a.data.name_en.localeCompare(b.data.name_en),
);

const titleCase = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());
const uniq = (arr: string[]) => [...new Set(arr)].sort((a, b) => a.localeCompare(b));

// Target areas — a fixed, curated set of body areas so the filter stays tidy.
// Each pose's many raw target_areas map into these buckets; unlisted raw values
// aren't surfaced as filters. The buckets live in src/lib/poseFacets.ts — edit
// them there, because they also decide which class hub a pose points at, and two
// copies of a taxonomy is exactly how those drift apart.
const areaKeys = (p: (typeof poses)[number]) => poseAreaKeys(p.data.target_areas);
const areaLabel = poseAreaLabel;
// Show every target area that has at least one pose (in anatomical order) so runners
// can filter straight to IT band, calves, hip flexors, hamstrings, quads and glutes.
const presentAreas = POSE_AREA_BUCKETS.filter((b) => poses.some((p) => areaKeys(p).includes(b.key)));

// Each area also has a class hub behind it. The index is a reference page, so it
// should offer the way out to a full class as well as the way in to a pose.
assertPoseHubMapping();
const areaHubs = [...new Set(presentAreas.map((b) => POSE_AREA_TO_HUB[b.key]).filter(Boolean))].map(
  (key) => {
    const f = FOCUS.find((x) => x.key === key)!;
    return { key: f.key, heading: f.heading.replace(/^Yin Yoga for /, ''), tagline: f.tagline };
  },
);
const levelOrder = ['beginner', 'intermediate', 'advanced'];
const levels = uniq(poses.map((p) => p.data.accessibility)).sort(
  (a, b) => levelOrder.indexOf(a) - levelOrder.indexOf(b),
);
---

<BaseLayout
  title="Yin Yoga Pose Reference — Yin Yoga with Katie"
  description="A reference library of yin yoga poses — cues, benefits, hold times and cautions. Browse by target area and level, or open a class to practice them in sequence."
>
  <div class="wrap">
    <header class="hero">
      <p class="eyebrow">Yin Yoga · Reference</p>
      <h1>Poses</h1>
      <p class="alt">the shapes behind the classes — cues, benefits and cautions for each</p>
    </header>

    <p class="page-intro">
      Yin Yoga works deep — into the connective tissue, joints and fascia — by holding
      simple, floor-based shapes for several minutes at a time. This is a plain-language
      reference to the poses I use in my classes: what each one targets, how long to hold
      it, which props help, and what to take care with. Open any pose to read it, set the
      built-in hold timer, or jump to the classes it appears in.
    </p>

    <section>
      <div class="filters" id="filters">
        <div class="facet">
          <span class="facet-label">Target areas</span>
          <div class="chips">
            {presentAreas.map((b) => (
              <button type="button" class="chip" data-facet="area" data-value={b.key} aria-pressed="false">{b.label}</button>
            ))}
          </div>
        </div>

        <div class="facet">
          <span class="facet-label">Level</span>
          <div class="chips">
            {levels.map((l) => (
              <button type="button" class="chip" data-facet="level" data-value={l} aria-pressed="false">{titleCase(l)}</button>
            ))}
          </div>
        </div>

        <div class="filter-meta">
          <button type="button" class="chip chip-clear" id="clear-filters" hidden>Clear filters</button>
          <span class="count" id="result-count" aria-live="polite"></span>
        </div>
      </div>

      <div class="tiles" id="tiles">
        {poses.map((p) => (
          <a
            class="tile"
            href={`/poses/${p.data.slug}`}
            data-tile
            data-areas={areaKeys(p).join('|')}
            data-level={p.data.accessibility}
          >
            <div class="tile-thumb">
              {p.data.images.length > 0 ? (
                <img class="tile-img pose" src={p.data.images[0]} alt={p.data.name_en} loading="lazy" />
              ) : (
                <div class="tile-img pose tile-noimg">{p.data.name_en}</div>
              )}
            </div>
            <div class="tile-body">
              <h3 class="tile-name">{p.data.name_en}</h3>
              <div class="tile-tags">
                {areaKeys(p).slice(0, 3).map((k) => <span class="tag">{areaLabel(k)}</span>)}
                <span class="tag tag-level">{titleCase(p.data.accessibility)}</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <p class="empty" id="empty" hidden>No poses match those filters yet.</p>
    </section>

    <footer>
      <p class="src">Poses are the building blocks classes are built from.</p>
    </footer>

    {/* Out of the reference layer and into the practice layer. A pose page tells
        you how a shape works; most people reading one want to be taught it, and
        the two ways to be taught are a guided routine or a full class. */}
    <section class="px-next">
      <h2>When you'd rather be led</h2>
      <p class="px-next-sub">
        The poses above are the reference. To practise them, follow a
        <a href="/routines">guided routine</a> with a hold timer, or press play on a
        full class for the part of you that needs it:
      </p>
      <div class="px-next-links">
        {areaHubs.map((h) => (
          <a class="px-next-link" href={`/videos/for/${h.key}`}>
            <span class="px-next-name">{h.heading}</span>
            <span class="px-next-tag">{h.tagline}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

  {/* These index pages are landing pages in their own right — every nav click
      lands here — and until now they were the only public pages with no ask. */}
  <Cta source="poses-index" heading="Want to practise, not just read?" />
</BaseLayout>

<script>
  // Client-side faceted filtering — OR within a facet, AND across.
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-tile]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-facet]'));
  const clearBtn = document.getElementById('clear-filters') as HTMLButtonElement | null;
  const countEl = document.getElementById('result-count');
  const emptyEl = document.getElementById('empty');

  const active: Record<string, Set<string>> = {
    area: new Set(),
    level: new Set(),
  };

  const split = (v: string | undefined) => (v ? v.split('|').filter(Boolean) : []);

  function apply() {
    let visible = 0;
    for (const tile of tiles) {
      const areas = split(tile.dataset.areas);
      const level = tile.dataset.level ?? '';

      const okArea = active.area.size === 0 || areas.some((a) => active.area.has(a));
      const okLvl = active.level.size === 0 || active.level.has(level);

      const show = okArea && okLvl;
      tile.hidden = !show;
      if (show) visible++;
    }

    const anyActive = active.area.size + active.level.size > 0;
    if (clearBtn) clearBtn.hidden = !anyActive;
    if (emptyEl) emptyEl.hidden = visible > 0;
    if (countEl) {
      countEl.textContent = anyActive
        ? `${visible} of ${tiles.length} ${tiles.length === 1 ? 'pose' : 'poses'}`
        : '';
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const facet = chip.dataset.facet!;
      const value = chip.dataset.value!;
      const set = active[facet];
      if (set.has(value)) {
        set.delete(value);
        chip.setAttribute('aria-pressed', 'false');
        chip.classList.remove('active');
      } else {
        set.add(value);
        chip.setAttribute('aria-pressed', 'true');
        chip.classList.add('active');
      }
      apply();
    });
  }

  clearBtn?.addEventListener('click', () => {
    for (const key of Object.keys(active)) active[key].clear();
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', 'false');
      chip.classList.remove('active');
    }
    apply();
  });

  apply();
</script>

<style>
  /* The bridge out of the reference layer. Uses the global flipping tokens only,
     so it themes correctly without a [data-theme] rule (which Astro strips from
     a scoped block — see the note in global.css). */
  .px-next { margin: 56px 0 8px; }
  .px-next h2 { font-family: var(--display); font-weight: 500; font-size: clamp(22px, 3vw, 28px); color: var(--plum); margin: 0 0 8px; }
  .px-next-sub { font-size: 15.5px; color: var(--ink-soft); margin: 0 0 20px; max-width: 62ch; }
  .px-next-sub a { color: var(--gold-solid); font-weight: 600; }
  .px-next-links { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .px-next-link { display: flex; flex-direction: column; gap: 3px; background: var(--paper-2); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .px-next-link:hover { border-color: var(--gold); transform: translateY(-2px); }
  .px-next-name { font-family: var(--display); font-weight: 500; font-size: 17px; color: var(--plum); }
  .px-next-tag { font-size: 13.5px; line-height: 1.45; color: var(--ink-soft); }
</style>
