---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import katieAbout from '../assets/katie-about.jpg';
import katieHello from '../assets/katie-hello.jpg';

// The Runner's Reset — long-form sales page. Copy is LOCKED, verbatim from
// runner-reset-copy-pack/A-sales-page.md. This file is a visual/structural
// redesign only — no copy is rewritten, cut, reordered, or added, except the
// two elements Kevin explicitly kept (the credibility stat strip and the
// "what happens the moment you join" steps) and one bit of sticky-bar UI micro-label.
//
// Hidden (noindex + excluded from sitemap) until launch, matching the /runners funnel.
// The buy buttons POST to /api/checkout (Lemon Squeezy) — a plain form so it
// works without JS. Price + entitlement logic live in the Netlify functions.

// Target sessions — one card each. Pose photo = a representative shape the
// session draws on (real /poses/*.jpg imagery, not stock). `angle` may carry
// <em>/<strong> from the copy, so it's rendered with set:html.
const TARGET_SESSIONS = [
  { name: 'Hips & Hip Flexors', time: '~15 min', pose: 'dragon',
    angle: 'Running plus sitting equals tight hips — open them first, and your whole stride frees up.' },
  { name: 'Hamstrings & Glutes', time: '~18 min', pose: 'caterpillar',
    angle: 'Your hamstrings do the hardest braking work in every stride — give them their length back.' },
  { name: 'Calves, Ankles & Feet', time: '~14 min', pose: 'toe-squat',
    angle: 'It all starts at your feet — stiff ankles change everything above them, and almost no runner works here.' },
  { name: 'Quads & Outer Hip — the “IT band” one', time: '~18 min', pose: 'saddle',
    angle: 'You can’t stretch your IT band — it’s a tough band of fascia — but you <em>can</em> release the muscles that pull on it. This session does exactly that.' },
  { name: 'Lower Back & Spine', time: '~16 min', pose: 'sphinx',
    angle: 'Every run is impact your spine absorbs. This is how you gently undo the day’s compression.' },
];

const FULL_RESETS = [
  { name: 'The Full Reset', time: '~53 min', pose: 'sleeping-swan',
    angle: 'Every area, one unhurried practice. The everyday all-rounder.' },
  { name: 'The Restorative Reset', time: '~50 min', pose: 'supported-fish',
    angle: 'Gentler and fully supported with props — for tired legs and low-energy days.' },
];

const GUIDED_PATHS = [
  { term: 'Start Here', body: 'a short welcome video: what Yin is, why it suits runners, how to use the library.' },
  { term: 'By level', body: 'new to Yin, returning, or experienced: a path for each.' },
  { term: 'By need', body: 'tight hips, after a long run, sore feet, race week, only fifteen minutes: a simple chooser points you to the right session.' },
  { term: 'Calendar plans', body: 'load a plan straight into your calendar with reminders: <strong>The 6-Week Foundation</strong> (the gentle on-ramp), <strong>The Weekly Rhythm</strong> (a repeatable week to keep forever), and <strong>Race Prep</strong> (a taper-aware plan that eases off into race week).' },
];

const BONUSES = [
  { name: 'The Deep-Rest Reset — a guided NSDR', solves: 'a lie-down Non-Sleep Deep Rest (yoga nidra) to run after any session or long run — the deep-rest practice increasingly studied for easing recovery and better sleep', worth: '$29' },
  { name: '12+ Runner Routines', solves: 'ready-made follow-along routines with the built-in timer (no video) — targeted, short to long, gentle to deep, one for every runner’s need', worth: '$39' },
  { name: 'The Runner’s Pose Library', solves: 'every pose with plain cues and cautions', worth: '$29' },
  { name: 'The Never-Skip Scheduler', solves: 'your plan pre-loaded into your calendar, with a quiet nudge when a session’s due — because showing up is what actually drives results', worth: '$19' },
];

const ogImage = new URL('/og/card.png', Astro.site);
ogImage.searchParams.set('t', 'The Runner’s Reset');
ogImage.searchParams.set('s', 'Short follow-along Yin sessions to undo the tightness running builds up');
---

{/* Alternate H1s to A/B test against the recommended headline:
    1. Running tightens the same chain of tissues, run after run. This is how you undo it.
    2. The recovery half of training — finally laid out for you.
    3. A 30-second stretch only skims the surface. Time in the shape is what reaches it. */}

<BaseLayout
  title="The Runner's Reset — Yin Yoga for Runners, by Katie"
  description="Running quietly stiffens the tissues that keep you running well. The Runner's Reset is a library of short, follow-along Yin sessions that give that range back — fifteen to twenty quiet minutes at a time."
  image={ogImage.href}
  noindex={true}
>
  <div class="rr">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <header class="rr-hero" id="rrHero">
      <div class="rr-read">
        <p class="eyebrow">For runners with tight hips, heavy legs and good intentions</p>
        <h1>Stop getting tighter. Keep running — at your best.</h1>
        <p class="rr-sub">
          Running quietly stiffens the very tissues that keep you running well — hips, hamstrings,
          calves, quads, lower back. The Runner's Reset is a library of short, follow-along Yin sessions
          that give that range back, fifteen to twenty quiet minutes at a time.
        </p>
        <form method="POST" action="/api/checkout" class="rr-cta-form"><button type="submit" class="rr-cta">Join the Runner's Reset — $49 founding price →</button></form>
        <p class="rr-cta-note">One-time payment · lifetime access · 30-day keep-it guarantee</p>
      </div>
    </header>

    <div class="rr-band">
      <figure class="rr-hero-img">
        <Image src={katieHello} alt="Katie, the teacher behind The Runner's Reset" width={1040} height={585} loading="eager" fetchpriority="high" />
      </figure>
      <ul class="rr-stats" aria-label="About Katie">
        <li><strong>6 years</strong><span>teaching Yin</span></li>
        <li><strong>300+</strong><span>free classes</span></li>
        <li><strong>12k+</strong><span>on YouTube</span></li>
        <li><strong>Arhanta</strong><span>Ashram trained</span></li>
      </ul>
    </div>

    {/* ── The part of every run you skip ───────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-read">
        <h2>The part of every run you skip</h2>
        <p>You know the scene. You finish a good run — heavy legs, tight hips, that familiar pull down the back of your thigh. You mean to stretch. You check your watch instead.</p>
        <p>It's not laziness. Nobody ever made the stretching part <em>simple</em>. So it slides — run after run — and the tightness quietly stacks up. Hips one month. Calves the next. Then one morning your stride feels short and braced, a niggle starts whispering, and you're googling "how long does it take to lose fitness."</p>
        <p>Here's the thing worth knowing: that slow build-up isn't a character flaw, and it isn't inevitable. It's just the half of training nobody laid out for you.</p>
      </div>
    </section>

    {/* ── Why running tightens you ─────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-read">
        <h2>Why running tightens you (and why a quick stretch doesn't undo it)</h2>
        <p>Running makes you fitter by loading the same chain of tissues over and over — hips, hamstrings, glutes, calves, quads, lower back. Thousands of steps, the same shapes, every run. That repetition is what builds you up. It's also what quietly shortens and stiffens those exact tissues over weeks — especially if, like most of us, you spend the rest of the day in a chair.</p>
        <p>And a hurried 30-second stretch barely touches it. The deeper tissue around your hips and joints doesn't respond to a quick pull; it responds to <em>time</em>. That's all Yin yoga really is: you settle into a shape and stay for a few quiet minutes — nothing forced, only ever to about 60–80% of your capacity — and let gravity and your breath do the slow work a rushed stretch can't.</p>
        <p>Two things happen when you practice this way:</p>
        <ul class="plain">
          <li><strong>Your range of motion improves.</strong> Long, still holds are well suited to easing the tightness running builds up in the hips, hamstrings, calves and ankles — the mobility that lets your stride stay long and easy.</li>
          <li><strong>Your body actually recovers.</strong> The long, quiet holds help you shift down into your rest state, so you come away calmer and less braced — the recovery half of training runners so often skip.</li>
        </ul>
        <p class="rr-lead">You don't need to become flexible. You just need to stop getting tighter.</p>
        <p class="rr-note-med"><em>A gentle note: this is general education, not medical advice. Yin helps with everyday tightness — it doesn't treat or prevent injury, and sharp or lasting pain belongs with a physio or doctor.</em></p>
      </div>
    </section>

    {/* ── Who this is for ──────────────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-band">
        <div class="rr-who">
          <h2>Who this is for</h2>
          <ul class="rr-check">
            <li>You run — for fitness, for sanity, for the long game. Parkruns to marathons, it doesn't matter.</li>
            <li>You sit most of the day, and you can feel what that's doing to your hips.</li>
            <li>You keep meaning to stretch, and you keep not doing it — because nothing ever told you <em>what</em>, <em>when</em>, or <em>for how long</em>.</li>
            <li>You're not flexible. Good. Yin was made for exactly that.</li>
          </ul>
          <p class="rr-inset"><strong>Who it isn't for:</strong> if you're carrying an acute injury or sharp pain, see a physio first — this library will still be here when you're cleared to move. And if you're after sweaty power yoga, this is the opposite of that, on purpose.</p>
        </div>
      </div>
    </section>

    {/* ── What's inside ────────────────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-read">
        <h2>What's inside The Runner's Reset</h2>
        <p>It's a practice library, not a course you fall behind on. Two kinds of session, plus guided paths that tell you exactly which one to press play on.</p>
        <h3 class="rr-h3">Target sessions — one for each place running tightens</h3>
        <p>Short, follow-along Yin sessions, about 14–18 minutes each — each shape followed by a short rebound, the still pause that lets the release settle before the next one. Do one right after a run, while you're warm, or whenever a specific spot is grumbling.</p>
      </div>

      <div class="rr-band">
        <ul class="rr-cards" aria-label="Target sessions">
          {TARGET_SESSIONS.map((s) => (
            <li class="rr-scard">
              <div class="rr-scard-media">
                <img src={`/poses/${s.pose}.jpg`} alt={`Yin shape used in the ${s.name} session`} loading="lazy" width="480" height="360" />
              </div>
              <div class="rr-scard-body">
                <div class="rr-scard-head">
                  <h4>{s.name}</h4>
                  <span class="rr-dur">{s.time}</span>
                </div>
                <p set:html={s.angle}></p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="rr-read">
        <h3 class="rr-h3">Full Reset sessions — the whole chain, in one practice</h3>
        <p>Because running doesn't tighten one muscle — it tightens a chain, and a tight link pulls on the next. Around 50 minutes each, made for rest days.</p>
      </div>

      <div class="rr-band">
        <ul class="rr-cards rr-cards-3" aria-label="Full Reset sessions">
          {FULL_RESETS.map((s) => (
            <li class="rr-scard">
              <div class="rr-scard-media">
                <img src={`/poses/${s.pose}.jpg`} alt={`Yin shape used in ${s.name}`} loading="lazy" width="480" height="360" />
              </div>
              <div class="rr-scard-body">
                <div class="rr-scard-head">
                  <h4>{s.name}</h4>
                  <span class="rr-dur">{s.time}</span>
                </div>
                <p set:html={s.angle}></p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="rr-read">
        <h3 class="rr-h3">Guided paths — so you're never left guessing</h3>
      </div>
      <div class="rr-band">
        <ul class="rr-paths" aria-label="Guided paths">
          {GUIDED_PATHS.map((p) => (
            <li class="rr-path">
              <strong class="rr-path-term">{p.term}</strong>
              <span set:html={p.body}></span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rr-read">
        <h3 class="rr-h3">Every session page gives you five ways in</h3>
        <p>The follow-along video, an on-screen hold timer (so you can practice screen-free once you know the shapes), the plain-English <em>why</em> behind the session, written cues you can read, and a body map showing where it works. Whatever kind of learner you are, it's covered.</p>
      </div>
      <div class="rr-band">
        {/* PLACEHOLDER — swap for a real screenshot of a session page once the course is filmed. */}
        <figure class="rr-ph rr-ph-wide">
          <span class="rr-ph-label">Session page preview</span>
          <span class="rr-ph-note">A screenshot of a real session — the video, hold timer, cues and body map — drops in here after filming.</span>
        </figure>
      </div>
    </section>

    {/* ── The bonuses ──────────────────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-band">
        <h2 class="rr-band-h2">The bonuses — one for each classic runner problem</h2>
        <ul class="rr-bonus" aria-label="Included bonuses">
          {BONUSES.map((b) => (
            <li class="rr-bonus-row">
              <div class="rr-bonus-main">
                <strong>{b.name}</strong>
                <span>{b.solves}</span>
              </div>
              <span class="rr-bonus-worth"><span class="rr-bonus-worth-l">worth</span>{b.worth}</span>
            </li>
          ))}
        </ul>
        <p class="rr-bonus-foot">Priced separately, the bonuses alone come to <strong>$116</strong> — before you count the seven sessions and the guided paths. You get all of it, for good, for less than a couple of physio sessions.</p>
      </div>
    </section>

    {/* ── CTA — after the offer / bonuses ──────────────────────────────── */}
    <div class="rr-read rr-cta-row">
      <form method="POST" action="/api/checkout" class="rr-cta-form"><button type="submit" class="rr-cta">Join the Runner's Reset — $49 founding price →</button></form>
      <p class="rr-cta-note">One-time payment · lifetime access · 30-day keep-it guarantee</p>
    </div>

    {/* ── Who's teaching you ───────────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-band">
        <div class="rr-bio">
          <Image class="rr-bio-photo" src={katieAbout} alt="Katie, a qualified Yin yoga teacher, in tree pose" width={520} height={694} loading="lazy" />
          <div class="rr-bio-text">
            <h2>Who's teaching you</h2>
            <p>I'm Katie. I've taught Yin yoga for six years, trained at the Arhanta Yoga Ashram, and shared over 300 free classes on YouTube — including the runner classes many of you found me through. My whole approach is the opposite of hype: slow, kind, and honest about what Yin can and can't do. The Runner's Reset is everything I know about the runner's body, laid out so you never have to wonder what to press play on.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ── The keep-it guarantee ────────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-band">
        <div class="rr-guarantee">
          <span class="rr-seal" aria-hidden="true"><span class="rr-seal-n">30</span><span class="rr-seal-t">day<br />keep-it</span></span>
          <h2>The keep-it guarantee</h2>
          <p>Join, and practice along for 30 days. If your hips, hamstrings and calves don't feel noticeably looser — if you're not moving more easily — email me for a full refund, <strong>and keep lifetime access to the entire library anyway</strong>.</p>
          <p>I can offer that because the risk should sit with me, not you. If Yin doesn't help your running, I haven't earned your money — it's that simple.</p>
        </div>
      </div>
    </section>

    {/* ── The founding price ───────────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-band">
        <div class="rr-offer">
          <h2>The founding price (and the honest small print)</h2>
          <p class="rr-price"><span class="rr-price-now">$49</span><span class="rr-price-meta">for the first 100 runners<br /><span class="rr-price-then">then $67</span></span></p>
          <p>The Runner's Reset is <strong>$49 for the first 100 runners</strong>. One payment, lifetime access — every session, every path, every bonus, and everything I add to the library later.</p>
          <p>Once those 100 founding places are taken, the price becomes <strong>$67</strong>. That's the only deadline here, and it's a real one: I want a founding group practicing, telling me what to build next, before the doors settle at full price. No countdown-timer theater — when the hundred are gone, they're gone.</p>
          <div class="rr-next">
            <p class="rr-next-h">What happens the moment you join</p>
            <ol>
              <li>Secure checkout — one payment, no subscription.</li>
              <li>Instant access to the whole library, yours for good.</li>
              <li>Start with the Post-Run Reset after your very next run.</li>
            </ol>
          </div>
          <form method="POST" action="/api/checkout" class="rr-cta-form"><button type="submit" class="rr-cta">Join the Runner's Reset — $49 founding price →</button></form>
          <p class="rr-cta-note">One-time payment · lifetime access · 30-day keep-it guarantee</p>
        </div>
      </div>
    </section>

    {/* ── FAQ ──────────────────────────────────────────────────────────── */}
    <section class="rr-sec">
      <div class="rr-read">
        <h2>Questions runners ask</h2>
        <div class="rr-faqs">
          <details class="faq"><summary>"I'm not flexible. At all."</summary><p>Perfect — that's exactly who Yin is for. It isn't about how far you fold. You only ever go to about 60–80% of your capacity and let the shape soften from there. Tight runners are the whole idea.</p></details>
          <details class="faq"><summary>"I don't have time."</summary><p>The Target sessions are under twenty minutes — shorter than a proper cooldown. Do one after a run, or in the evening while you wind down. Little and often does far more than long and rare.</p></details>
          <details class="faq"><summary>"Does stretching even help runners?"</summary><p>The quick, bouncy kind before a run? Not much — and long deep holds <em>before</em> running can actually leave you feeling loose and less powerful, which is why everything here is built for after runs and rest days. What long, still holds are genuinely good at is improving range of motion and helping your body shift into recovery. That's the lane Yin stays in — I won't promise you it cures injuries or flushes anything, because it doesn't.</p></details>
          <details class="faq"><summary>"Is this just YouTube videos?"</summary><p>The free channel stays free, always. What the library adds is the system: runner-specific sequences for every link in the chain, guided paths so you always know what's next, hold timers, written cues, body maps, a deep-rest NSDR, ready-made routines, and calendar plans with reminders. It's the difference between a pile of classes and a plan.</p></details>
          <details class="faq"><summary>"What do I need?"</summary><p>A mat, a cushion or two, maybe a belt or a block if you have one. Every pose has a gentler option — nothing requires flexibility or fancy props.</p></details>
          <details class="faq"><summary>"What if it's not for me?"</summary><p>Then the keep-it guarantee has you: a full refund within 30 days, and you keep everything. You genuinely can't lose money here.</p></details>
        </div>
      </div>
    </section>

    {/* ── The close ────────────────────────────────────────────────────── */}
    <section class="rr-sec rr-close" id="rrClose">
      <div class="rr-read">
        <h2>The quiet habit that keeps you running</h2>
        <p>You don't need to overhaul your training. You need fifteen unhurried minutes, often enough, in the right shapes — and someone to lay them out for you. That's all this is.</p>
        <p>Roll out your mat after your next run. Let the tightness go before it settles in. And keep running — at your best — for as long as running matters to you.</p>
        <form method="POST" action="/api/checkout" class="rr-cta-form"><button type="submit" class="rr-cta">Join the Runner's Reset — $49 founding price →</button></form>
        <p class="rr-cta-note">One-time payment · lifetime access · first 100 runners, then $67 · 30-day keep-it guarantee</p>
        <p class="rr-signoff">Take good care of yourself,<br /><span class="rr-sig">katie</span></p>
        <p class="rr-note-med"><em>The Runner's Reset is general education, not medical advice. If you have sharp, nervy or lasting pain, please see a physiotherapist or doctor.</em></p>
      </div>
    </section>
  </div>

  {/* Subtle sticky CTA — mobile only, appears past the hero, dismissible.
      Hidden by default (works fully with JS off); revealed by the script below. */}
  <div class="rr-sticky" id="rrSticky" hidden>
    <div class="rr-sticky-inner">
      <span class="rr-sticky-text"><strong>$49</strong> founding price</span>
      <form method="POST" action="/api/checkout" class="rr-cta-form"><button type="submit" class="rr-cta rr-cta-sm">Join →</button></form>
      <button class="rr-sticky-x" type="button" aria-label="Dismiss offer bar">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  // Sticky mobile CTA — progressive enhancement. If this never runs (JS off),
  // the bar stays [hidden] and the page works entirely on its in-flow CTAs.
  const bar = document.getElementById('rrSticky');
  const hero = document.getElementById('rrHero');
  const close = document.getElementById('rrClose');
  if (bar && hero && close && 'IntersectionObserver' in window) {
    let pastHero = false;
    let atEnd = false;
    let dismissed = false;
    try { dismissed = sessionStorage.getItem('rrStickyDismissed') === '1'; } catch (e) {}
    const apply = () => {
      const show = pastHero && !atEnd && !dismissed;
      if (show) {
        bar.hidden = false;
        requestAnimationFrame(() => bar.classList.add('is-visible'));
      } else {
        bar.classList.remove('is-visible');
        bar.hidden = true;
      }
    };
    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
      apply();
    }, { threshold: 0 }).observe(hero);
    new IntersectionObserver(([e]) => {
      atEnd = e.isIntersecting;
      apply();
    }, { threshold: 0 }).observe(close);
    bar.querySelector('.rr-sticky-x')?.addEventListener('click', () => {
      dismissed = true;
      try { sessionStorage.setItem('rrStickyDismissed', '1'); } catch (e) {}
      apply();
    });
  }
</script>

<style>
  /* ── Width system ──────────────────────────────────────────────────────
     BaseLayout puts the slot straight in <body> (no width cap), so this page
     owns its measure: a 680px reading column, and an ~908px band for the
     visual blocks (cards, panels, photos) so scrolling gets a gentle pulse. */
  .rr { padding: 8px 0 72px; }
  .rr-read { max-width: 680px; margin: 0 auto; padding: 0 22px; }
  .rr-band { max-width: 908px; margin: 0 auto; padding: 0 22px; }
  .rr-sec { margin-top: clamp(52px, 8vw, 84px); }

  /* ── Hero ──────────────────────────────────────────────────────────── */
  .rr-hero { text-align: center; padding: clamp(36px, 7vw, 60px) 0 0; }
  .rr-hero h1 { text-wrap: balance; }
  .rr-sub { font-size: clamp(17px, 2.3vw, 19px); line-height: 1.62; color: var(--ink-soft); max-width: 60ch; margin: 20px auto 28px; }

  /* Buy CTA — the brand rosewood; fixed colors so it holds on light + dark */
  .rr-cta-form { display: contents; }
  .rr-cta {
    display: inline-block; background: #89494B; color: #fff; font-weight: 600;
    font-family: inherit; font-size: 17px; line-height: 1.3; padding: 15px 28px;
    border-radius: 100px; text-decoration: none; border: none; cursor: pointer;
    box-shadow: 0 10px 26px -14px rgba(137,73,75,.9);
    transition: background .15s ease, transform .15s ease;
  }
  .rr-cta:hover { background: #6E3A3C; color: #fff; transform: translateY(-1px); }
  .rr-cta:focus-visible { outline: 2px solid var(--plum); outline-offset: 3px; }
  .rr-cta-note { font-size: 13.5px; color: var(--ink-soft); margin: 13px 0 0; }
  .rr-cta-row { text-align: center; margin-top: clamp(40px, 6vw, 60px); }

  /* Hero image */
  .rr-hero-img { margin: clamp(26px, 4vw, 38px) 0 0; }
  .rr-hero-img img {
    width: 100%; height: clamp(240px, 44vw, 460px); object-fit: cover; object-position: center 30%;
    border-radius: 20px; display: block; border: 1px solid var(--line);
  }

  /* Credibility stats */
  .rr-stats { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; margin: 14px 0 0; padding: 0; }
  .rr-stats li {
    flex: 1 1 130px; background: var(--paper-2); border: 1px solid var(--line);
    border-radius: 14px; padding: 15px 10px; text-align: center;
